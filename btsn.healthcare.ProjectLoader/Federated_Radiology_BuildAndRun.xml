<?xml version="1.0" encoding="UTF-8"?>
<!-- Federated Radiology: radiology requests to the Radiology service alone (v002)
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Run:     ant -f Federated_Radiology_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f Federated_Radiology_BuildAndRun.xml analyse -->
<project name="Federated_Radiology_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="healthcare/Workflow/Federated_Radiology_Workflow"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/healthcare/Deployment.json"/>
    <property name="token.generator.class" value="org.btsn.healthcare.eventgenerators.GenericHealthcareTokenGenerator"/>
    <property name="workflow.process.name" value="healthcare/Workflow/Federated_Radiology_Workflow"/>
    <property name="init.process.name" value="healthcare/Initializers/Radiology_Initialization"/>
    <property name="collector.process.name" value="healthcare/Collectors/Radiology_Collector"/>
    <property name="rule.version" value="v002"/>
    <property name="query.version" value="v002"/>

    <!-- Tokens: one block per event generator, each with its own rule version. -->
    <property name="eg1.id" value="FEDERATED_RADIOLOGY_REQUEST"/>
    <property name="eg1.version" value="v002"/>
    <property name="eg1.place" value="P4_Place"/>
    <property name="eg1.operation" value="federatedRadiologyRequest"/>
    <property name="eg1.format.service" value="RadiologyService"/>
    <property name="eg1.tokens" value="10"/>
    <property name="token.count" value="10"/>

    <!-- Hosts used by the service deployment -->
    <property name="run.p4" value="true"/>
    <property name="first.node" value="p4"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
