<?xml version="1.0" encoding="UTF-8"?>
<!-- Emergency Department: Triage -> [Laboratory, Cardiology, Radiology] -> Diagnosis -> Treatment (v001)
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Run:     ant -f Emergency_Department_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f Emergency_Department_BuildAndRun.xml analyse -->
<project name="Emergency_Department_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="healthcare/Workflow/Emergency_Department_Patient_Workflow"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/healthcare/Deployment.json"/>
    <property name="token.generator.class" value="org.btsn.healthcare.eventgenerators.GenericHealthcareTokenGenerator"/>
    <property name="workflow.process.name" value="healthcare/Workflow/Emergency_Department_Patient_Workflow"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001"/>

    <!-- Tokens: one block per event generator, each with its own rule version. -->
    <property name="eg1.id" value="PATIENT_ARRIVAL"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processTriageAssessment"/>
    <property name="eg1.format.service" value="TriageService"/>
    <property name="eg1.tokens" value="10"/>
    <property name="token.count" value="10"/>

    <!-- Hosts used by the service deployment: nodes of the infrastructure, each running the host program -->
    <property name="hosts" value="P1,P2,P3,P4,P5,P6"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
