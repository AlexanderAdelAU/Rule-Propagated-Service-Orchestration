<?xml version="1.0" encoding="UTF-8"?>
<!-- Three concurrent healthcare workflows: Emergency Department patients (v003), a triage canary test (v002)
     and federated radiology requests (v001), fired together.
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Run:     ant -f Triple_Workflow_Emergencey_Department_Concurrent.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f Triple_Workflow_Emergencey_Department_Concurrent.xml analyse -->
<project name="Triple_Workflow_Emergencey_Department_Concurrent" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="Three concurrent healthcare workflows: Emergency Department (v003), triage canary (v002), federated radiology (v001)"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/healthcare/Deployment.json"/>
    <property name="token.generator.class" value="org.btsn.healthcare.eventgenerators.GenericHealthcareTokenGenerator"/>
    <property name="workflow.process.name" value="healthcare/Workflow/Emergency_Department_Patient_Workflow"/>
    <property name="init.process.name" value="healthcare/Initializers/Multi_Service_Initialization"/>
    <property name="collector.process.name" value="healthcare/Collectors/Multi_Service_Collector"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001,v002,v003"/>

    <!-- Tokens: one block per event generator, each with its own rule version. The generators fire together. -->
    <property name="eg1.id" value="PATIENT_ARRIVAL"/>
    <property name="eg1.version" value="v003"/>
    <property name="eg1.process" value="healthcare/Workflow/Emergency_Department_Patient_Workflow"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processTriageAssessment"/>
    <property name="eg1.format.service" value="TriageService"/>
    <property name="eg1.tokens" value="20"/>
    <property name="eg2.id" value="CANARY_TEST"/>
    <property name="eg2.version" value="v002"/>
    <property name="eg2.process" value="healthcare/Workflow/Triage_CanaryTest_Workflow"/>
    <property name="eg2.place" value="P1_Place"/>
    <property name="eg2.operation" value="processTriageAssessment"/>
    <property name="eg2.format.service" value="TriageService"/>
    <property name="eg2.tokens" value="10"/>
    <property name="eg3.id" value="FEDERATED_RADIOLOGY_REQUEST"/>
    <property name="eg3.version" value="v001"/>
    <property name="eg3.process" value="healthcare/Workflow/Federated_Radiology_Workflow"/>
    <property name="eg3.place" value="P4_Place"/>
    <property name="eg3.operation" value="federatedRadiologyRequest"/>
    <property name="eg3.format.service" value="RadiologyService"/>
    <property name="eg3.tokens" value="10"/>
    <property name="token.count" value="10"/>

    <!-- Hosts used by the service deployment -->
    <property name="run.p1" value="true"/>
    <property name="run.p2" value="true"/>
    <property name="run.p3" value="true"/>
    <property name="run.p4" value="true"/>
    <property name="run.p5" value="true"/>
    <property name="run.p6" value="true"/>
    <property name="first.node" value="p1"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
