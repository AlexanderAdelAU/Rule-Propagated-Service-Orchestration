<?xml version="1.0" encoding="UTF-8"?>
<!-- Stroke code (v001) across four organisations, its stand-down compensation (v002), and a metro hospital's routine
     emergency department patients (v003), sharing the regional pathology (P2) and imaging (P4) providers.
     The ambulance service (P7) screens each suspected stroke and alerts the comprehensive stroke centre, which holds
     its angiography suite (P8). The receiving hospital (P9) orders CT and bloods together; the telestroke neurologist
     at the stroke centre (P10) decides; the receiving hospital thrombolyses (P11) and the stroke centre retrieves
     clots (P12). Every route that will not retrieve a clot reaches the Signal node "Stand Down Suite", which starts
     the stand-down process: it releases the hold where it was made (P8). On the shared hosts a stroke code is served
     before the routine patients queued there, because its process has the higher priority.
     The case mix (TokenFormats/StrokeScreenService.json): ten suspected strokes, nine stroke codes, three clot
     retrievals, six stand-downs.
     The angiography suite (AngioSuiteService) is the stroke centre's own booking system, called over REST: P8's host
     calls http://127.0.0.1:8090/stroke-centre/suite/hold and .../release (ServiceDeploymentFolder/healthcare/StrokeCode.json),
     so the hold is recorded in the stroke centre's system and the stand-down undoes it there. The run starts that
     system (RestServiceServer) if nothing answers on 8090, and stops it at the end; or start it yourself first:
              ant -f Stroke_Code_With_Emergency_Department.xml stroke-centre
     Run:     ant -f Stroke_Code_With_Emergency_Department.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     The stroke centre on its own machine (192.168.1.152), with tokens reaching it over UDP like any other host:
              ant -f Stroke_Code_With_Emergency_Department.xml host-packages -Dstroke.centre=remote   (copy the zip there, run launch.bat)
              ant -f Stroke_Code_With_Emergency_Department.xml -Dstroke.centre=remote
     Analyse: ant -f Stroke_Code_With_Emergency_Department.xml analyse   (the usual report, then the suite-hold balance) -->
<project name="Stroke_Code_With_Emergency_Department" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="Stroke code (v001) with its stand-down (v002) and routine emergency department patients (v003)"/>
    <!-- Where the stroke centre runs. Left out: on this machine, its booking system called over REST (started below).
         -Dstroke.centre=remote: the stroke centre's host P8 on 192.168.1.152 (InfrastructureDefinitionFolder/TwoHost_StrokeCentre.json),
         its booking inside that host. Build its package once with host-packages -Dstroke.centre=remote, run launch.bat
         there, then run this launcher here with -Dstroke.centre=remote. -->
    <property name="stroke.centre" value="local"/>
    <!-- Choosing those machines (the editor's Machines: TwoHost_StrokeCentre, or -Dinfrastructure) means the same. -->
    <condition property="stroke.centre.remote"><or>
        <equals arg1="${stroke.centre}" arg2="remote"/>
        <equals arg1="${infrastructure}" arg2="TwoHost_StrokeCentre"/>
    </or></condition>
    <condition property="infrastructure" value="TwoHost_StrokeCentre"><isset property="stroke.centre.remote"/></condition>
    <condition property="launcher.profile.file" value="${basedir}/../btsn.services/deployments/healthcare/StrokeCodeInProcessDeployment.json"
               else="${basedir}/../btsn.services/deployments/healthcare/StrokeCodeDeployment.json"><isset property="stroke.centre.remote"/></condition>
    <property name="token.generator.class" value="org.btsn.healthcare.eventgenerators.GenericHealthcareTokenGenerator"/>
    <property name="workflow.process.name" value="healthcare/Workflow/Stroke_Code_Workflow"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001,v002,v003"/>

    <!-- Ten suspected strokes, one every 2.5 s, each living 120 s. -->
    <property name="eg1.id" value="AMBULANCE_CALL"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.process" value="healthcare/Workflow/Stroke_Code_Workflow"/>
    <property name="eg1.place" value="P7_Place"/>
    <property name="eg1.operation" value="screenPatient"/>
    <property name="eg1.format.service" value="StrokeScreenService"/>
    <property name="eg1.tokens" value="10"/>
    <property name="eg1.expire" value="120000"/>
    <property name="eg1.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/Stroke_Code_V001.csv"/>

    <!-- The stand-down process: deployed as v002 but fired by nothing here. The stroke code's Signal node starts it at
         its start node (STAND_DOWN), one token per stroke code that will not retrieve a clot. -->
    <property name="eg2.id" value="STAND_DOWN"/>
    <property name="eg2.version" value="v002"/>
    <property name="eg2.process" value="healthcare/Workflow/Stroke_StandDown_Workflow"/>
    <property name="eg2.place" value="P8_Place"/>
    <property name="eg2.operation" value="releaseSuite"/>
    <property name="eg2.expire" value="60000"/>
    <property name="eg2.started.by.signal" value="true"/>

    <!-- The metro hospital's routine patients, twenty in bursts of four every 5 s. -->
    <property name="eg3.id" value="PATIENT_ARRIVAL"/>
    <property name="eg3.version" value="v003"/>
    <property name="eg3.process" value="healthcare/Workflow/Emergency_Department_Patient_Workflow"/>
    <property name="eg3.place" value="P1_Place"/>
    <property name="eg3.operation" value="processTriageAssessment"/>
    <property name="eg3.format.service" value="TriageService"/>
    <property name="eg3.tokens" value="20"/>
    <property name="eg3.expire" value="120000"/>
    <property name="eg3.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/Stroke_Code_V003_Routine.csv"/>
    <property name="token.count" value="10"/>

    <!-- Hosts used by the service deployment: nodes of the infrastructure, each running the host program -->
    <property name="hosts" value="P1,P2,P3,P4,P5,P6,P7,P8,P9,P10,P11,P12"/>

    <import file="../btsn.services/process-runtime.xml"/>

    <!-- The stroke centre's booking system, serving AngioSuiteService over REST on this machine. -->
    <!-- The run starts it (start-stroke-centre), so the editor's check before Run on hosts need not find it answering. -->
    <property name="launcher.starts.services" value="http://127.0.0.1:8090/stroke-centre/"/>
    <property name="stroke.centre.port" value="8090"/>
    <property name="stroke.centre.url" value="http://127.0.0.1:${stroke.centre.port}/stroke-centre/suite"/>
    <property name="stroke.centre.catalogue" location="../btsn.common/BusinessServiceDefinitions/healthcare/Healthcare.json"/>
    <macrodef name="stroke-centre-server">
        <attribute name="spawn" default="false"/>
        <sequential>
            <java classname="org.btsn.invocation.RestServiceServer" fork="true" spawn="@{spawn}" classpathref="common.classpath">
                <arg value="port=${stroke.centre.port}"/><arg value="catalogue=${stroke.centre.catalogue}"/>
                <arg value="services=AngioSuiteService"/><arg value="log=${output.dir}/StrokeCentre.out.txt"/>
            </java>
        </sequential>
    </macrodef>
    <target name="stroke-centre" depends="prepare-runtime" description="Run the stroke centre's booking system (REST, port 8090) until stopped">
        <echo message="The stroke centre's booking system: ${stroke.centre.url} (log: StrokeCentre.out.txt). Stop it with Ctrl+C, or ${stroke.centre.url}/stop"/>
        <stroke-centre-server/>
    </target>
    <target name="start-stroke-centre" depends="prepare-runtime" unless="stroke.centre.remote">
        <condition property="stroke.centre.running"><http url="${stroke.centre.url}"/></condition>
        <echo message="The stroke centre's booking system is already answering at ${stroke.centre.url}" if:set="stroke.centre.running" xmlns:if="ant:if"/>
        <antcall target="spawn-stroke-centre"/>
    </target>
    <target name="spawn-stroke-centre" unless="stroke.centre.running">
        <echo message="Starting the stroke centre's booking system at ${stroke.centre.url}"/>
        <stroke-centre-server spawn="true"/>
        <waitfor maxwait="30" maxwaitunit="second" checkevery="500" timeoutproperty="stroke.centre.silent"><http url="${stroke.centre.url}"/></waitfor>
        <fail if="stroke.centre.silent" message="The stroke centre's booking system did not start on port ${stroke.centre.port}"/>
        <touch file="${launcher.runtime.dir}/StrokeCentre.started"/>
    </target>
    <target name="stop-stroke-centre">
        <available file="${launcher.runtime.dir}/StrokeCentre.started" property="stroke.centre.ours"/>
        <antcall target="stop-our-stroke-centre"/>
    </target>
    <target name="stop-our-stroke-centre" if="stroke.centre.ours">
        <get src="${stroke.centre.url}/stop" dest="${launcher.runtime.dir}/StrokeCentre.stopped" ignoreerrors="true" quiet="true"/>
        <delete file="${launcher.runtime.dir}/StrokeCentre.started"/>
        <delete file="${launcher.runtime.dir}/StrokeCentre.stopped" quiet="true"/>
    </target>
    <!-- The run: the booking system first (unless it is already answering), then the usual run, then stop what this started. -->
    <target name="run-complete-workflow" depends="start-stroke-centre,process-runtime.run-complete-workflow,stop-stroke-centre"
            description="Start the stroke centre's booking system if needed, initialise, run the processes and collect their records (default)"/>

    <!-- The usual analysis, then the balance of suite holds across the two processes: each hold the stroke code made
         (v001 T_out_P8) must be used by a clot retrieval (v001 T_out_P12) or released by the stand-down process
         (v002 T_out_P8, arc released), exactly once. -->
    <target name="analyse" depends="launcher-jar-runtime-support.analyse" description="Analyse the Monitor database, then check the suite-hold balance">
        <java classname="org.btsn.derby.Analysis.CompensationBalance" fork="true" failonerror="true" dir="${monitor.project.dir}">
            <classpath refid="monitor.classpath"/>
            <arg value="resource=suite hold"/>
            <arg value="opened=v001:T_out_P8"/>
            <arg value="settled=v001:T_out_P12"/>
            <arg value="undone=v002:T_out_P8:released"/>
        </java>
    </target>
</project>
