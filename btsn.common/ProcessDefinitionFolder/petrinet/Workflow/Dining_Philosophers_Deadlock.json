  "textElements": [
    {
      "x": 40,
      "y": 40,
      "text": "Dining philosophers, deadlocked start",
      "fontSize": 14,
      "fontStyle": 1,
      "color": -16777216
    },
    {
      "x": 40,
      "y": 62,
      "text": "Start: every philosopher holds his right-hand fork. A cycle: every join waits for a fork that never comes.",
      "fontSize": 11,
      "fontStyle": 0,
      "color": -16777216
    },
    {
      "x": 40,
      "y": 80,
      "text": "Seated facing the table, each philosopher's right-hand fork is shared with the next philosopher counter-clockwise.",
      "fontSize": 11,
      "fontStyle": 0,
      "color": -16777216
    },
    {
      "x": 40,
      "y": 98,
      "text": "A philosopher eats when its join (T_in) holds both forks; its ForkNode T_out then hands both forks back.",
      "fontSize": 11,
      "fontStyle": 0,
      "color": -16777216
    },
    {
      "x": 600,
      "y": 137,
      "text": "Seat 1: Plato (host P1)",
      "fontSize": 11,
      "fontStyle": 1,
      "color": -16777216
    },
    {
      "x": 600,
      "y": 153,
      "text": "right fork shared with Socrates",
      "fontSize": 11,
      "fontStyle": 0,
      "color": -16777216
    },
    {
      "x": 600,
      "y": 167,
      "text": "left fork shared with Locke",
      "fontSize": 11,
      "fontStyle": 0,
      "color": -16777216
    },
    {
      "x": 503,
      "y": 374,
      "text": "fork Plato/Socrates",
      "fontSize": 10,
      "fontStyle": 2,
      "color": -16777216
    },
    {
      "x": 72,
      "y": 382,
      "text": "Seat 2: Socrates (host P2)",
      "fontSize": 11,
