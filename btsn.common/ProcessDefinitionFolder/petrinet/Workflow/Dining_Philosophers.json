  "textElements": [
    {
      "x": 40,
      "y": 40,
      "text": "Dining philosophers: five places in a ring, forks passed between neighbours",
      "fontSize": 14,
      "fontStyle": 1,
      "color": -16777216
    },
    {
      "x": 40,
      "y": 62,
      "text": "Initial marking (TABLE): P1 and P3 hold both forks, P4 holds the fork it shares with P5. No cycle, so no deadlock.",
      "fontSize": 11,
      "fontStyle": 0,
      "color": -16777216
    },
    {
      "x": 40,
      "y": 80,
      "text": "Philosopher Pk eats when its join holds both forks, then its ForkNode T_out hands fork_k to both neighbours.",
      "fontSize": 11,
      "fontStyle": 0,
      "color": -16777216
    }
  ],
