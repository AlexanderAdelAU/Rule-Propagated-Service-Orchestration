<?xml version="1.0" encoding="UTF-8"?>
<!-- EXPERIMENTAL: adapted from Rendezvous_Workflow_BuildAndRun.xml; not runtime-verified.
     One physical F1 family is granted exclusively to P1 or P2.
     The selected branch forks into two children, reunited at one JoinNode.
     Run with: ant -f SingleFork_ExclusiveHandoff_Workflow_BuildAndRun.xml -Dhost.address=127.0.0.1
     Use the monitor to check no packet loss, conflicting child IDs or leaked joins. -->
<project name="SingleFork_ExclusiveHandoff_Workflow_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="petrinet/Workflow/SingleFork_ExclusiveHandoff_Workflow"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/models/SingleFork_ExclusiveHandoff_WorkflowDeployment.json"/>
    <property name="workflow.process.name" value="petrinet/Workflow/SingleFork_ExclusiveHandoff_Workflow"/>
    <property name="infrastructure" value="NineHost_ExclusiveHandoff"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001"/>
    <property name="eg1.id" value="F1_START"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="Arbiter_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/SingleFork_ExclusiveHandoff_Workflow_BuildAndRun.csv"/>
    <property name="eg1.tokens" value="1"/>
    <property name="eg1.marking" value="Arbiter_Place.processToken=token"/>
    <property name="token.count" value="10"/>
    <property name="token.expire" value="15000"/>
    <property name="hosts" value="P1,P2,P3,P4,P5,P6,P7,P8,P9"/>
    <import file="../btsn.services/process-runtime.xml"/>
</project>
