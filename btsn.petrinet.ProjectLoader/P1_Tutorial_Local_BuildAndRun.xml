<?xml version="1.0" encoding="UTF-8"?>
<project name="P1_Tutorial_Local_BuildAndRun" default="run-complete-workflow" basedir=".">
    <description>Run P1_Tutorial_BuildAndRun.xml on one computer with the supplied loopback infrastructure.</description>
    <property name="launcher.profile.file" location="../btsn.services/deployments/models/P1_Tutorial_LocalDeployment.json"/>
    <property name="launcher.rules.file" location="../btsn.services/deployments/models/P1_Tutorial_LocalInfrastructure.ruleml.xml"/>
    <property name="infrastructure.definition.name" value="P1_Tutorial_LocalInfrastructure"/>
    <import file="P1_Tutorial_BuildAndRun.xml"/>
    <property name="tutorial.results.dir" location="../btsn.services/target/tutorial-results/P1"/>
    <property name="tutorial.export.classes" location="../btsn.services/target/tutorial-export"/>
    <property name="tutorial.source.commit" value="working-tree"/>
    <target name="export-tutorial-results" depends="build-launcher-jars"
            description="Export an already collected P1 run; stop the workflow hosts first">
        <mkdir dir="${tutorial.results.dir}"/>
        <mkdir dir="${tutorial.export.classes}"/>
        <mkdir dir="${tutorial.export.classes}/empty-sourcepath"/>
        <javac srcdir="../docs/tutorials/p1" includes="ExportP1TutorialResults.java"
               destdir="${tutorial.export.classes}" release="15" includeantruntime="false"
               sourcepath="${tutorial.export.classes}/empty-sourcepath">
            <classpath refid="monitor.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.ExportP1TutorialResults" fork="true"
              failonerror="true" maxmemory="512m" dir="${monitor.project.dir}">
            <jvmarg value="-Djava.awt.headless=true"/>
            <classpath><path refid="monitor.classpath"/><pathelement location="${tutorial.export.classes}"/></classpath>
            <arg file="${tutorial.results.dir}"/><arg file=".."/>
            <arg value="${rule.version}"/><arg value="${token.count}"/><arg value="${tutorial.source.commit}"/>
        </java>
    </target>
</project>
