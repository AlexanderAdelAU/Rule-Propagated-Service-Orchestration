<?xml version="1.0" encoding="UTF-8"?>
<!-- Two concurrent workflows on P1-P4: fork/join (v001) and its P1-P2 companion (v002)
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Run:     ant -f P1_P2_P3_P4_Concurrent_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f P1_P2_P3_P4_Concurrent_BuildAndRun.xml analyse -->
<project name="P1_P2_P3_P4_Concurrent_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="Two concurrent workflows on P1-P4: fork/join (v001) and its P1-P2 companion (v002)"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/models/ForkDeployment.json"/>
    <property name="workflow.process.name" value="petrinet/Workflow/P1_P2_P3_P4_Fork_Join_Workflow"/>
    <property name="init.process.name" value="common/Initializers/P1_P2_P3_P4_Initialization"/>
    <property name="collector.process.name" value="common/Collectors/P1_P2_P3_P4_Collector"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001,v002"/>

    <!-- Tokens: one block per event generator, each with its own rule version. The generators fire together. -->
    <property name="eg1.id" value="EVENT_GENERATOR"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.process" value="petrinet/Workflow/P1_P2_P3_P4_Fork_Join_Workflow"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.tokens" value="10"/>
    <property name="eg2.id" value="P1_EVENTGENERATOR"/>
    <property name="eg2.version" value="v002"/>
    <property name="eg2.process" value="petrinet/Workflow/P1_P2_ForkCompanion_Workflow"/>
    <property name="eg2.place" value="P1_Place"/>
    <property name="eg2.operation" value="processToken"/>
    <property name="eg2.tokens" value="10"/>
    <property name="token.count" value="10"/>
    <property name="workflow.completion.seconds" value="5"/>

    <!-- Hosts used by the service deployment -->
    <property name="run.p1" value="true"/>
    <property name="run.p2" value="true"/>
    <property name="run.p3" value="true"/>
    <property name="run.p4" value="true"/>
    <property name="first.node" value="p1"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
