<?xml version="1.0" encoding="UTF-8"?>

<project name="FinancialSystem_Stage5_PriorityPreemption_BuildAndRun" default="run-complete-workflow" basedir="."
	    xmlns:if="ant:if" xmlns:unless="ant:unless">
	<description>
		RPSO Stage 5 - Priority Overtaking of Background Work

        v002 is a normal 40-token background workflow on shared P1/P2 services,
        using an ordinary irregular arrival schedule. It starts first; v001 begins
        10 seconds later while v002 is still running.
        The experiment tests queue-level priority overtaking only: an already executing
        v002 operation is never interrupted. When a worker becomes free and both
        versions are waiting, v001 should dequeue first; when no v001 work is
        waiting, v002 should continue to make progress.
	</description>

	<!-- ======================================================================= -->
	<!-- DEPLOYMENT CONFIGURATION                                                -->
	<!-- ======================================================================= -->
	<!-- Ant contacts independently running receivers; it never starts the hosts. -->
	<property file="deployment.properties" />
	<property name="deployment.port" value="41000" />
	<property name="p1.deployment.host" value="127.0.0.1" />
	<property name="p2.deployment.host" value="127.0.0.1" />
	<property name="p3.deployment.host" value="127.0.0.1" />
	<property name="p4.deployment.host" value="127.0.0.1" />
	<property name="p5.deployment.host" value="127.0.0.1" />
	<property name="monitor.deployment.host" value="127.0.0.1" />

	<!-- ======================================================================= -->
	<!-- PROPERTIES                                                              -->
	<!-- ======================================================================= -->

	<!-- Process names for each phase -->
	<property name="init.process.name" value="petrinet/Initializers/P1_P2_P3_P4_P5_Initialization" />
	<!-- Each workflow has its own topology/rule version; physical services remain shared. -->
	<property name="workflow1.process.name" value="petrinet/Workflow/FinancialSystem_P1_P5_Workflow" />
	<property name="workflow2.process.name" value="petrinet/Workflow/FinancialSystem_Stage3_PreScreen_Workflow" />
	<property name="infrastructure.definition.name" value="FinancialSystem_Infrastructure" />
	<property name="collector.process.name" value="petrinet/Collectors/P1_P2_P3_P4_P5_Collector" />

	<!-- Phase 1: Initialization parameters (v999 = admin/non-instrumented) -->
	<property name="init.version" value="v999" />
	<property name="db.init.operation" value="purgeAndInitialize" />
	<property name="sequence.id.init.p1" value="999000000" />
	<property name="sequence.id.init.p2" value="999100000" />
	<property name="sequence.id.init.p3" value="999200000" />
	<property name="sequence.id.init.p4" value="999300000" />
	<property name="sequence.id.init.p5" value="999350000" />
	<property name="sequence.id.init.monitor" value="999400000" />

	<!-- ======================================================================= -->
	<!-- ======================================================================= -->
	<!-- WORKFLOW 1: Full Loan Application (v001)                                -->
	<!-- ======================================================================= -->
	<property name="workflow1.version" value="v001" />
	<property name="workflow1.generator.id" value="APPLICATION_SUBMITTED" />
	<property name="workflow1.target.place" value="P1_Place" />
	<property name="workflow1.target.operation" value="processToken" />
	<property name="workflow1.token.count" value="15" />
	<property name="workflow1.token.expire" value="120000" />
	<property name="workflow1.trigger.file" value="Stage5_V001_Urgent.csv" />
	<property name="workflow1.token.data" value="application_id=LOAN-STAGE5-URGENT,annual_income=85000,requested_amount=25000,credit_score=720,fraud_risk=low" />

	<!-- ======================================================================= -->
	<!-- WORKFLOW 2: Financial Pre-Screen (v002)                                 -->
	<!-- Same physical P1/P2 services and operations; independent v002 topology. -->
	<!-- ======================================================================= -->
	<property name="workflow2.version" value="v002" />
	<property name="workflow2.generator.id" value="PRESCREEN_SUBMITTED" />
	<property name="workflow2.target.place" value="P1_Place" />
	<property name="workflow2.target.operation" value="processToken" />
	<property name="workflow2.token.count" value="40" />
	<property name="workflow2.token.expire" value="120000" />
	<property name="workflow2.trigger.file" value="Stage5_V002_Background.csv" />
	<property name="workflow2.token.data" value="application_id=PRESCREEN-STAGE5-BACKGROUND,annual_income=90000,requested_amount=22000,credit_score=680,fraud_risk=low" />

	<!-- Phase 3: Collector parameters -->
	<property name="collector.version" value="v999" />
	<property name="collector.operation" value="collectAllData" />
	<property name="collector.query.versions" value="v001,v002" />
	<property name="sequence.id.collect.p1" value="999010000" />
	<property name="sequence.id.collect.p2" value="999020000" />
	<property name="sequence.id.collect.p3" value="999030000" />
	<property name="sequence.id.collect.p4" value="999040000" />
	<property name="sequence.id.collect.p5" value="999050000" />
	<property name="collector.delay.seconds" value="3" />

	<!-- Timing parameters -->
	<property name="service.startup.seconds" value="3" />
	<property name="phase.delay.seconds" value="5" />
	<property name="deploy.wait.seconds" value="3" />
	<property name="v001.fire.delay.seconds" value="10" />
	<property name="workflow.drain.seconds" value="25" />

	<!-- Base directories -->
	<property name="build.file.dir" location="." />
	<property name="petrinet.root.dir" location="../" />

	<!-- Common project -->
	<property name="common.project.dir" location="${petrinet.root.dir}/btsn.common" />
	<property name="lib.dir" location="${common.project.dir}/lib" />
	<property name="class.dir" location="${common.project.dir}/target/host-runtime/btsn-infrastructure.jar" />
	<property name="services.project.dir" location="${petrinet.root.dir}/btsn.services" />
	<property name="service.bundle.dir" location="${services.project.dir}/target/deployment" />
	<property name="common.src.dir" location="${common.project.dir}/src" />

	<!-- Output directory -->
	<property name="output.dir" location="${build.file.dir}" />
	<property name="p1.output.file" location="${output.dir}/P1_Place.out.txt" />
	<property name="p2.output.file" location="${output.dir}/P2_Place.out.txt" />
	<property name="p3.output.file" location="${output.dir}/P3_Place.out.txt" />
	<property name="p4.output.file" location="${output.dir}/P4_Place.out.txt" />
	<property name="p5.output.file" location="${output.dir}/P5_Place.out.txt" />
	<property name="monitor.output.file" location="${output.dir}/MonitorService.out.txt" />

	<!-- P1-P5 Services -->
	<property name="p1.project.dir" location="${petrinet.root.dir}/btsn.petrinet.places.p1" />
	<property name="p1.host.jar" location="${p1.project.dir}/target/btsn.petrinet.places.p1.jar" />

	<property name="p2.project.dir" location="${petrinet.root.dir}/btsn.petrinet.places.p2" />
	<property name="p2.host.jar" location="${p2.project.dir}/target/btsn.petrinet.places.p2.jar" />

	<property name="p3.project.dir" location="${petrinet.root.dir}/btsn.petrinet.places.p3" />
	<property name="p3.host.jar" location="${p3.project.dir}/target/btsn.petrinet.places.p3.jar" />

	<property name="p4.project.dir" location="${petrinet.root.dir}/btsn.petrinet.places.p4" />
	<property name="p4.host.jar" location="${p4.project.dir}/target/btsn.petrinet.places.p4.jar" />

	<property name="p5.project.dir" location="${petrinet.root.dir}/btsn.petrinet.places.p5" />
	<property name="p5.host.jar" location="${p5.project.dir}/target/btsn.petrinet.places.p5.jar" />

	<!-- Monitor Service -->
	<property name="monitor.project.dir" location="${petrinet.root.dir}/btsn.common.Monitor" />
	<property name="monitor.runtime.jar" location="${monitor.project.dir}/target/jar-runtime/btsn-monitor.jar" />

	<!-- Event Generators -->
	<property name="generator.project.dir" location="${petrinet.root.dir}/btsn.common.eventgenerators" />
	<property name="generator.runtime.jar" location="${generator.project.dir}/target/jar-runtime/btsn-eventgenerators.jar" />

	<!-- Java Classes -->
	<property name="service.loader.class" value="org.btsn.handlers.ServiceLoader" />
	<property name="init.event.generator.class" value="org.btsn.common.eventgenerators.DatabaseInitialization_EventGenerator" />
	<property name="token.generator.class" value="org.btsn.petrinet.eventgenerators.GenericPetriNetTokenGenerator" />
	<property name="collector.event.generator.class" value="org.btsn.common.eventgenerators.Common_Collector_EventGenerator" />

	<!-- ======================================================================= -->
	<!-- CLASSPATHS                                                              -->
	<!-- ======================================================================= -->

	<path id="common.classpath">
		<fileset dir="${lib.dir}" erroronmissingdir="false" excludesfile="${services.project.dir}/target/runtime-library-excludes.txt">
			<include name="*.jar" />
		</fileset>
		<pathelement location="${class.dir}" />
		<fileset dir="${service.bundle.dir}/services" includes="*.jar" />
		<fileset dir="${service.bundle.dir}/lib" includes="*.jar" />
	</path>

	<path id="p1.classpath">
		<path refid="common.classpath" />
		<pathelement location="${p1.host.jar}" />
	</path>

	<path id="p2.classpath">
		<path refid="common.classpath" />
		<pathelement location="${p2.host.jar}" />
	</path>

	<path id="p3.classpath">
		<path refid="common.classpath" />
		<pathelement location="${p3.host.jar}" />
	</path>

	<path id="p4.classpath">
		<path refid="common.classpath" />
		<pathelement location="${p4.host.jar}" />
	</path>

	<path id="p5.classpath">
		<path refid="common.classpath" />
		<pathelement location="${p5.host.jar}" />
	</path>

	<path id="monitor.classpath">
		<path refid="common.classpath" />
		<pathelement location="${monitor.runtime.jar}" />
	</path>

	<path id="generator.classpath">
		<path refid="common.classpath" />
		<pathelement location="${generator.runtime.jar}" />
	</path>

	<!-- ======================================================================= -->
	<!-- DEPLOYMENT MODE RESOLUTION                                              -->
	<!-- ======================================================================= -->

	<target name="build-runtime" description="Build host infrastructure and independently packaged services">
		<ant antfile="${services.project.dir}/build.xml" target="build-workflow-runtime" inheritall="false" />
	</target>

	<target name="deploy-services" depends="rebuild-service-ruleml">
		<fail unless="deployment.token">Set deployment.token in deployment.properties or with -Ddeployment.token</fail>
		<ant antfile="${services.project.dir}/build.xml" target="remote-bundle" inheritall="false" />
		<macrodef name="deploy-service">
			<attribute name="component"/><attribute name="host"/>
			<sequential>
				<java classname="org.btsn.deployment.DeploymentClient" fork="true" failonerror="true">
					<classpath><pathelement location="${services.project.dir}/target/btsn-deployment-host.jar"/></classpath>
					<arg value="@{host}"/><arg value="${deployment.port}"/><arg value="${deployment.token}"/>
					<arg file="${services.project.dir}/target/remote-service-deployment.zip"/><arg value="@{component}"/><arg value="${workflow1.version}"/>
				</java>
			</sequential>
		</macrodef>
		<deploy-service component="p1" host="${p1.deployment.host}"/>
		<deploy-service component="p2" host="${p2.deployment.host}"/>
		<deploy-service component="p3" host="${p3.deployment.host}"/>
		<deploy-service component="p4" host="${p4.deployment.host}"/>
		<deploy-service component="p5" host="${p5.deployment.host}"/>
		<deploy-service component="monitor" host="${monitor.deployment.host}"/>
	</target>

	<target name="create-output-directory">
		<mkdir dir="${output.dir}" />
	</target>

	<target name="clean-output" description="Clean previous output files">
		<delete file="${p1.output.file}" quiet="true" />
		<delete file="${p2.output.file}" quiet="true" />
		<delete file="${p3.output.file}" quiet="true" />
		<delete file="${p4.output.file}" quiet="true" />
		<delete file="${p5.output.file}" quiet="true" />
		<delete file="${monitor.output.file}" quiet="true" />
		<echo message="Previous output files cleaned" />
	</target>


	<target name="clean-generated-workflow-rules" description="Remove generated v001/v002 process-routing rules before regeneration">
		<echo message="=== Removing previously generated workflow-routing rules ===" />

		<!-- v001 full workflow: business route mapped to P1-P5; Monitor is observation infrastructure -->
		<delete dir="${p1.project.dir}/RuleFolder.${workflow1.version}/processToken" quiet="true" failonerror="false" />
		<delete dir="${p2.project.dir}/RuleFolder.${workflow1.version}/processToken" quiet="true" failonerror="false" />
		<delete dir="${p3.project.dir}/RuleFolder.${workflow1.version}/processToken" quiet="true" failonerror="false" />
		<delete dir="${p4.project.dir}/RuleFolder.${workflow1.version}/processToken" quiet="true" failonerror="false" />
		<delete dir="${p5.project.dir}/RuleFolder.${workflow1.version}/processToken" quiet="true" failonerror="false" />

		<!-- v002 pre-screen workflow: logical Validation/CreditCheck mapped to shared P1/P2.
		     P3-P5 v002 processToken folders are also removed so stale topology
		     cannot survive from an earlier experiment. -->
		<delete dir="${p1.project.dir}/RuleFolder.${workflow2.version}/processToken" quiet="true" failonerror="false" />
		<delete dir="${p2.project.dir}/RuleFolder.${workflow2.version}/processToken" quiet="true" failonerror="false" />
		<delete dir="${p3.project.dir}/RuleFolder.${workflow2.version}/processToken" quiet="true" failonerror="false" />
		<delete dir="${p4.project.dir}/RuleFolder.${workflow2.version}/processToken" quiet="true" failonerror="false" />
		<delete dir="${p5.project.dir}/RuleFolder.${workflow2.version}/processToken" quiet="true" failonerror="false" />

		<echo message="Generated workflow-routing rules removed; current process JSON must regenerate them." />
	</target>

	<target name="generate-workflow-bindings" depends="build-runtime,clean-generated-workflow-rules" description="Generate canonical bindings for both workflows">
		<echo message="=== Generating Workflow 1 Bindings (${workflow1.process.name}) ===" />
		<java classname="org.btsn.rulecontroller.TopologyBindingGenerator" 
		      classpathref="generator.classpath"
		      dir="${common.project.dir}"
		      fork="true"
		      failonerror="true">
			<arg value="${workflow1.process.name}" />
			<arg value="${workflow1.version}" />
		</java>
		
		<echo message="=== Generating Workflow 2 Bindings (${workflow2.process.name}) ===" />
		<java classname="org.btsn.rulecontroller.TopologyBindingGenerator" 
		      classpathref="generator.classpath"
		      dir="${common.project.dir}"
		      fork="true"
		      failonerror="true">
			<arg value="${workflow2.process.name}" />
			<arg value="${workflow2.version}" />
		</java>
		<echo message="All workflow bindings generated successfully" />
	</target>

	<target name="rebuild-service-ruleml" depends="generate-workflow-bindings" 
	        description="Generate bindings and rebuild master Service.ruleml">
		<echo message="=== Building Master Service.ruleml (v001) ===" />
		<java classname="org.btsn.utils.BuildMasterServiceRuleBase" 
		      classpathref="generator.classpath"
		      dir="${common.project.dir}"
		      fork="true"
		      failonerror="true">
			<arg value="${workflow1.version}" />
			<arg value="ALL" />
		</java>
		
		<echo message="=== Building Master Service.ruleml (v002) ===" />
		<java classname="org.btsn.utils.BuildMasterServiceRuleBase" 
		      classpathref="generator.classpath"
		      dir="${common.project.dir}"
		      fork="true"
		      failonerror="true">
			<arg value="${workflow2.version}" />
			<arg value="ALL" />
		</java>
		<echo message="Master Service.ruleml files built successfully" />
	</target>

	<!-- ======================================================================= -->
	<!-- MAIN WORKFLOW TARGET                                                    -->
	<!-- ======================================================================= -->

	<target name="run-complete-workflow" depends="create-output-directory,clean-output,deploy-services"
	        description="Run priority-overtaking experiment with background v002 and later urgent v001 work">

		<echo message="================================================================" />
		<echo message="  RPSO STAGE 5 - PRIORITY OVERTAKING  " />
		<echo message="================================================================" />
		<echo message="" />
		<echo message="  Workflows:" />
		<echo message="    1. ${workflow1.process.name} (${workflow1.version}): ${workflow1.token.count} tokens" />
		<echo message="    2. ${workflow2.process.name} (${workflow2.version}): ${workflow2.token.count} tokens" />
		<echo message="" />
		<echo message="  Priority model: v001 overtakes queued v002 only; executing v002 is never interrupted" />
		<echo message="================================================================" />

		<!-- Services have acknowledged startup on their receiving hosts. -->
			<sequential>
				<echo message="Waiting ${service.startup.seconds}s for services to start..." />
				<sleep seconds="${service.startup.seconds}" />

				<!-- ======================================================= -->
				<!-- PHASE 1: Database Initialization                        -->
				<!-- ======================================================= -->
				<echo message="" />
				<echo message="===============================================" />
				<echo message="    PHASE 1: DATABASE INITIALIZATION           " />
				<echo message="===============================================" />
				
				<!-- Deploy Initialization rules -->
				<echo message="Deploying Initialization rules..." />
				<java classname="${init.event.generator.class}" 
				      fork="true" dir="${generator.project.dir}" failonerror="true">
					<classpath refid="generator.classpath" />
					<arg value="-service" /><arg value="P1_InitializationService" />
					<arg value="-operation" /><arg value="${db.init.operation}" />
					<arg value="-version" /><arg value="${init.version}" />
					<arg value="-process" /><arg value="${init.process.name}" />
					<arg value="-sequenceId" /><arg value="${sequence.id.init.p1}" />
					<arg value="-tokens" /><arg value="0" />
				</java>

				<!-- Fire initialization tokens in PARALLEL.
				     Payload construction is now in-memory from the immutable template,
				     so concurrent generator JVMs share no mutable scratch file. -->
				<echo message="Firing initialization tokens in PARALLEL..." />
				<parallel>
					<java classname="${init.event.generator.class}" 
					      fork="true" dir="${generator.project.dir}" failonerror="true">
						<classpath refid="generator.classpath" />
						<arg value="-service" /><arg value="P1_InitializationService" />
						<arg value="-operation" /><arg value="${db.init.operation}" />
						<arg value="-version" /><arg value="${init.version}" />
						<arg value="-process" /><arg value="${init.process.name}" />
						<arg value="-sequenceId" /><arg value="${sequence.id.init.p1}" />
						<arg value="-tokens" /><arg value="1" />
						<arg value="-skipDeploy" />
					</java>
					<java classname="${init.event.generator.class}" 
					      fork="true" dir="${generator.project.dir}" failonerror="true">
						<classpath refid="generator.classpath" />
						<arg value="-service" /><arg value="P2_InitializationService" />
						<arg value="-operation" /><arg value="${db.init.operation}" />
						<arg value="-version" /><arg value="${init.version}" />
						<arg value="-process" /><arg value="${init.process.name}" />
						<arg value="-sequenceId" /><arg value="${sequence.id.init.p2}" />
						<arg value="-tokens" /><arg value="1" />
						<arg value="-skipDeploy" />
					</java>
					<java classname="${init.event.generator.class}" 
					      fork="true" dir="${generator.project.dir}" failonerror="true">
						<classpath refid="generator.classpath" />
						<arg value="-service" /><arg value="P3_InitializationService" />
						<arg value="-operation" /><arg value="${db.init.operation}" />
						<arg value="-version" /><arg value="${init.version}" />
						<arg value="-process" /><arg value="${init.process.name}" />
						<arg value="-sequenceId" /><arg value="${sequence.id.init.p3}" />
						<arg value="-tokens" /><arg value="1" />
						<arg value="-skipDeploy" />
					</java>
					<java classname="${init.event.generator.class}" 
					      fork="true" dir="${generator.project.dir}" failonerror="true">
						<classpath refid="generator.classpath" />
						<arg value="-service" /><arg value="P4_InitializationService" />
						<arg value="-operation" /><arg value="${db.init.operation}" />
						<arg value="-version" /><arg value="${init.version}" />
						<arg value="-process" /><arg value="${init.process.name}" />
						<arg value="-sequenceId" /><arg value="${sequence.id.init.p4}" />
						<arg value="-tokens" /><arg value="1" />
						<arg value="-skipDeploy" />
					</java>
					<java classname="${init.event.generator.class}" 
					      fork="true" dir="${generator.project.dir}" failonerror="true">
						<classpath refid="generator.classpath" />
						<arg value="-service" /><arg value="P5_InitializationService" />
						<arg value="-operation" /><arg value="${db.init.operation}" />
						<arg value="-version" /><arg value="${init.version}" />
						<arg value="-process" /><arg value="${init.process.name}" />
						<arg value="-sequenceId" /><arg value="${sequence.id.init.p5}" />
						<arg value="-tokens" /><arg value="1" />
						<arg value="-skipDeploy" />
					</java>
					<java classname="${init.event.generator.class}" 
					      fork="true" dir="${generator.project.dir}" failonerror="true">
						<classpath refid="generator.classpath" />
						<arg value="-service" /><arg value="Monitor_InitializationService" />
						<arg value="-operation" /><arg value="${db.init.operation}" />
						<arg value="-version" /><arg value="${init.version}" />
						<arg value="-process" /><arg value="${init.process.name}" />
						<arg value="-sequenceId" /><arg value="${sequence.id.init.monitor}" />
						<arg value="-tokens" /><arg value="1" />
						<arg value="-skipDeploy" />
					</java>
				</parallel>

				<echo message="=== Phase 1 Complete ===" />
				<sleep seconds="${phase.delay.seconds}" />

				<!-- ======================================================= -->
				<!-- PHASE 2: PRIORITY OVERTAKING                             -->
				<!-- Normal v002 starts first -> 10s delay -> v001 arrives while v002 continues -> both share P1/P2 -->
				<!-- ======================================================= -->
				<echo message="" />
				<echo message="===============================================" />
				<echo message="    PHASE 2: PRIORITY OVERTAKING               " />
				<echo message="===============================================" />
				<echo message="Background process: ${workflow2.process.name} (${workflow2.version})" />
				<echo message="Urgent process:     ${workflow1.process.name} (${workflow1.version})" />
				<echo message="[STAGE5 ASSERTION] Normal v002 workload starts first; v001 starts 10s later. Queue pre-emption only: in-service v002 completes; waiting v001 dequeues before waiting v002." />

				<!-- Commit both RuleBases before workload generation so this test isolates
				     scheduler behaviour from deployment/commitment timing. -->
				<echo message="[DEPLOY v001] Deploying and committing urgent ${workflow1.process.name}..." />
				<java classname="${token.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true">
					<classpath refid="generator.classpath" />
					<arg value="-version" /><arg value="${workflow1.version}" />
					<arg value="-process" /><arg value="${workflow1.process.name}" />
					<arg value="-infrastructure" /><arg value="${infrastructure.definition.name}" />
					<arg value="-place" /><arg value="${workflow1.target.place}" />
					<arg value="-operation" /><arg value="${workflow1.target.operation}" />
					<arg value="-tokens" /><arg value="0" />
					<arg value="-expire" /><arg value="${workflow1.token.expire}" />
					<arg value="-generator" /><arg value="${workflow1.generator.id}" />
				</java>
				<echo message="[DEPLOY v001] Commitment complete." />

				<echo message="[DEPLOY v002] Deploying and committing background ${workflow2.process.name}..." />
				<java classname="${token.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true">
					<classpath refid="generator.classpath" />
					<arg value="-version" /><arg value="${workflow2.version}" />
					<arg value="-process" /><arg value="${workflow2.process.name}" />
					<arg value="-infrastructure" /><arg value="${infrastructure.definition.name}" />
					<arg value="-place" /><arg value="${workflow2.target.place}" />
					<arg value="-operation" /><arg value="${workflow2.target.operation}" />
					<arg value="-tokens" /><arg value="0" />
					<arg value="-expire" /><arg value="${workflow2.token.expire}" />
					<arg value="-generator" /><arg value="${workflow2.generator.id}" />
				</java>
				<echo message="[DEPLOY v002] Commitment complete. Starting workload test." />

				<parallel>
					<!-- Background v002 begins immediately and arrives densely enough to
					     create a persistent queue at the shared P1 service. -->
					<sequential>
						<tstamp><format property="stage5.v002.fire.time" pattern="yyyy-MM-dd HH:mm:ss.SSS" /></tstamp>
						<echo message="[STAGE5 MARKER] v002 background firing started at ${stage5.v002.fire.time}" />
						<java classname="${token.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true">
							<classpath refid="generator.classpath" />
							<arg value="-version" /><arg value="${workflow2.version}" />
							<arg value="-process" /><arg value="${workflow2.process.name}" />
					<arg value="-infrastructure" /><arg value="${infrastructure.definition.name}" />
							<arg value="-place" /><arg value="${workflow2.target.place}" />
							<arg value="-operation" /><arg value="${workflow2.target.operation}" />
							<arg value="-tokens" /><arg value="${workflow2.token.count}" />
							<arg value="-expire" /><arg value="${workflow2.token.expire}" />
							<arg value="-generator" /><arg value="${workflow2.generator.id}" />
							<arg value="-data" /><arg value="${workflow2.token.data}" />
							<arg value="-triggerfile" /><arg value="${workflow2.trigger.file}" />
							<arg value="-skipDeploy" />
						</java>
						<tstamp><format property="stage5.v002.generator.complete.time" pattern="yyyy-MM-dd HH:mm:ss.SSS" /></tstamp>
						<echo message="[STAGE5 MARKER] v002 background generator completed at ${stage5.v002.generator.complete.time}" />
					</sequential>

					<!-- Urgent v001 begins later and arrives more slowly. The gaps between
					     v001 arrivals allow v002 to progress whenever no v001 is waiting. -->
					<sequential>
						<sleep seconds="${v001.fire.delay.seconds}" />
						<tstamp><format property="stage5.v001.fire.time" pattern="yyyy-MM-dd HH:mm:ss.SSS" /></tstamp>
						<echo message="[STAGE5 MARKER] v001 urgent firing started at ${stage5.v001.fire.time}" />
						<java classname="${token.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true">
							<classpath refid="generator.classpath" />
							<arg value="-version" /><arg value="${workflow1.version}" />
							<arg value="-process" /><arg value="${workflow1.process.name}" />
					<arg value="-infrastructure" /><arg value="${infrastructure.definition.name}" />
							<arg value="-place" /><arg value="${workflow1.target.place}" />
							<arg value="-operation" /><arg value="${workflow1.target.operation}" />
							<arg value="-tokens" /><arg value="${workflow1.token.count}" />
							<arg value="-expire" /><arg value="${workflow1.token.expire}" />
							<arg value="-generator" /><arg value="${workflow1.generator.id}" />
							<arg value="-data" /><arg value="${workflow1.token.data}" />
							<arg value="-triggerfile" /><arg value="${workflow1.trigger.file}" />
							<arg value="-skipDeploy" />
						</java>
						<tstamp><format property="stage5.v001.generator.complete.time" pattern="yyyy-MM-dd HH:mm:ss.SSS" /></tstamp>
						<echo message="[STAGE5 MARKER] v001 urgent generator completed at ${stage5.v001.generator.complete.time}" />
					</sequential>
				</parallel>

				<echo message="=== Stage 5 generators complete; draining shared queues for ${workflow.drain.seconds}s ===" />
				<sleep seconds="${workflow.drain.seconds}" />

				<!-- ======================================================= -->
								<!-- PHASE 3: Data Collection                                -->
				<!-- ======================================================= -->
				<echo message="" />
				<echo message="===============================================" />
				<echo message="    PHASE 3: DATA COLLECTION                   " />
				<echo message="===============================================" />

				<!-- Deploy Collector rules (first collector) -->
				<echo message="Deploying Collector rules..." />
				<java classname="${collector.event.generator.class}" 
				      fork="true" dir="${generator.project.dir}" failonerror="true">
					<classpath refid="generator.classpath" />
					<arg value="-service" /><arg value="P1_CollectorService" />
					<arg value="-operation" /><arg value="${collector.operation}" />
					<arg value="-version" /><arg value="${collector.version}" />
					<arg value="-process" /><arg value="${collector.process.name}" />
					<arg value="-queryVersion" /><arg value="${collector.query.versions}" />
					<arg value="-sequenceId" /><arg value="${sequence.id.collect.p1}" />
				</java>
				<sleep seconds="${collector.delay.seconds}" />

				<!-- Fire collectors sequentially with -skipDeploy -->
				<echo message="Collecting data from all services..." />

				<!-- P2 Collector -->
				<java classname="${collector.event.generator.class}" 
				      fork="true" dir="${generator.project.dir}" failonerror="true">
					<classpath refid="generator.classpath" />
					<arg value="-service" /><arg value="P2_CollectorService" />
					<arg value="-operation" /><arg value="${collector.operation}" />
					<arg value="-version" /><arg value="${collector.version}" />
					<arg value="-process" /><arg value="${collector.process.name}" />
					<arg value="-queryVersion" /><arg value="${collector.query.versions}" />
					<arg value="-sequenceId" /><arg value="${sequence.id.collect.p2}" />
					<arg value="-skipDeploy" />
				</java>
				<sleep seconds="${collector.delay.seconds}" />

				<!-- P3 Collector -->
				<java classname="${collector.event.generator.class}" 
				      fork="true" dir="${generator.project.dir}" failonerror="true">
					<classpath refid="generator.classpath" />
					<arg value="-service" /><arg value="P3_CollectorService" />
					<arg value="-operation" /><arg value="${collector.operation}" />
					<arg value="-version" /><arg value="${collector.version}" />
					<arg value="-process" /><arg value="${collector.process.name}" />
					<arg value="-queryVersion" /><arg value="${collector.query.versions}" />
					<arg value="-sequenceId" /><arg value="${sequence.id.collect.p3}" />
					<arg value="-skipDeploy" />
				</java>
				<sleep seconds="${collector.delay.seconds}" />

				<!-- P4 Collector -->
				<java classname="${collector.event.generator.class}" 
				      fork="true" dir="${generator.project.dir}" failonerror="true">
					<classpath refid="generator.classpath" />
					<arg value="-service" /><arg value="P4_CollectorService" />
					<arg value="-operation" /><arg value="${collector.operation}" />
					<arg value="-version" /><arg value="${collector.version}" />
					<arg value="-process" /><arg value="${collector.process.name}" />
					<arg value="-queryVersion" /><arg value="${collector.query.versions}" />
					<arg value="-sequenceId" /><arg value="${sequence.id.collect.p4}" />
					<arg value="-skipDeploy" />
				</java>
				<sleep seconds="${collector.delay.seconds}" />

				<!-- P5 Collector -->
				<java classname="${collector.event.generator.class}" 
				      fork="true" dir="${generator.project.dir}" failonerror="true">
					<classpath refid="generator.classpath" />
					<arg value="-service" /><arg value="P5_CollectorService" />
					<arg value="-operation" /><arg value="${collector.operation}" />
					<arg value="-version" /><arg value="${collector.version}" />
					<arg value="-process" /><arg value="${collector.process.name}" />
					<arg value="-queryVersion" /><arg value="${collector.query.versions}" />
					<arg value="-sequenceId" /><arg value="${sequence.id.collect.p5}" />
					<arg value="-skipDeploy" />
				</java>

				<echo message="=== Phase 3 Complete ===" />

				<echo message="" />
				<echo message="================================================================" />
				<echo message="  STAGE 5 PRIORITY-OVERTAKING EXECUTION COMPLETED              " />
				<echo message="================================================================" />
				<echo message="" />
				<echo message="Workflows Executed:" />
				<echo message="  1. ${workflow1.process.name} (${workflow1.version}): ${workflow1.token.count} tokens" />
				<echo message="  2. ${workflow2.process.name} (${workflow2.version}): ${workflow2.token.count} tokens" />
				<echo message="" />
				<echo message="Output files:" />
				<echo message="  P1: ${p1.output.file}" />
				<echo message="  P2: ${p2.output.file}" />
				<echo message="  P3: ${p3.output.file}" />
				<echo message="  P4: ${p4.output.file}" />
				<echo message="  P5: ${p5.output.file}" />
				<echo message="  Monitor: ${monitor.output.file}" />
				<echo message="" />
				<echo message="Services remain running on their receivers after Ant completes." />
			</sequential>
	</target>

	<!-- ======================================================================= -->
