<?xml version="1.0" encoding="UTF-8"?>
<!-- Launcher for petrinet/Workflow/TrafficLight_Workflow, on the shared process runtime.
     The shared phases live in btsn.services/process-runtime.xml.
     Run:     ant -f TrafficLight_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f TrafficLight_BuildAndRun.xml analyse -->
<project name="TrafficLight_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="petrinet/Workflow/TrafficLight_Workflow"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/models/TrafficLightDeployment.json"/>
    <property name="workflow.process.name" value="petrinet/Workflow/TrafficLight_Workflow"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001"/>

    <!-- Tokens -->
    <property name="eg1.id" value="TRAFFICLIGHT_EVENTGENERATOR"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <!-- NS_Green's T_in is a join with two inputs: the generator fires one workflow's two join tokens. -->
    <property name="eg1.join.inputs" value="2"/>
    <property name="token.count" value="2"/>
    <property name="workflow.completion.seconds" value="5"/>

    <!-- Hosts used by the service deployment: nodes of the infrastructure, each running the host program -->
    <property name="hosts" value="P1,P2,P3,P4,P5,P6"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
