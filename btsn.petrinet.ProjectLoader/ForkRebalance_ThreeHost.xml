<?xml version="1.0" encoding="UTF-8"?>
<!-- Live change of a forking, joining process: a rule version published while the old one runs.
     v001 (P1_P2_P3_P4_ForkRebalance_Workflow): P1 forks to P2 and P3, which join at P4.
     v002 (P1_P3_P4_P6_ForkRebalance_Workflow): the same, but the second branch runs on P6 instead of P2.
     On ThreeHost, P2 is on 192.168.1.152 and P6 on 192.168.1.90, so v002 moves that branch to the other machine.
     P6 is a node that joins mid-run: it is in the master ruleset from the start (address, service, contract) but is
     not started or initialised with the others. Start it when the launcher asks ("[LIVE] v002 brings P6 into use").
     Every place runs AlwaysTrueService, so every token forks and routes depend only on rules.
     v001 fires 90 tokens, one a second. At 20 s v002 is published; the publish is retried until P6 answers, P6's
     records are cleared, and v002 fires its 30 tokens while v001 is still firing, so both versions fork and join on
     P1, P3 and P4 together. Every workflow forks, and joins, under its own version.
     Hand-written: the editor's Build writes one process per launcher, and this launcher needs one per version.
     Run:     ant -f ForkRebalance_ThreeHost.xml        (on ThreeHost; -Dinfrastructure=SingleHost -Dhost.address=127.0.0.1 runs every host on this machine)
     Hosts:   ant -f ForkRebalance_ThreeHost.xml host-packages   (one package per other machine: ForkRebalance_ThreeHost_P2, ForkRebalance_ThreeHost_P3P6)
     Analyse: ant -f ForkRebalance_ThreeHost.xml analyse -->
<project name="ForkRebalance_ThreeHost" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="petrinet/Workflow/P1_P2_P3_P4_ForkRebalance_Workflow (v001, then v002 published live)"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/models/ForkRebalanceDeployment.json"/>
    <property name="workflow.process.name" value="petrinet/Workflow/P1_P2_P3_P4_ForkRebalance_Workflow"/>
    <!-- First phase: the nodes v001 uses. P6 joins with v002 and is initialised then. -->
    <property name="init.process.name" value="common/Initializers/P1_P2_P3_P4_Initialization"/>
    <property name="join.init.process.name" value="common/Initializers/P1_P2_P3_P4_P6_Initialization"/>
    <property name="collector.process.name" value="common/Collectors/P1_P2_P3_P4_P6_Collector"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001,v002"/>

    <!-- v001: deployed before the run, fires from the start. -->
    <property name="eg1.id" value="EVENT_GENERATOR"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/ForkRebalance_ThreeHost_V001.csv"/>
    <property name="eg1.tokens" value="90"/>

    <!-- v002: published to the running hosts at 20 s, bringing P6 into use; fires as soon as every host has committed it. -->
    <property name="eg2.id" value="EVENT_GENERATOR_V002"/>
    <property name="eg2.version" value="v002"/>
    <property name="eg2.process" value="petrinet/Workflow/P1_P3_P4_P6_ForkRebalance_Workflow"/>
    <property name="eg2.place" value="P1_Place"/>
    <property name="eg2.operation" value="processToken"/>
    <property name="eg2.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/ForkRebalance_ThreeHost_V002.csv"/>
    <property name="eg2.publish.at.seconds" value="20"/>
    <property name="eg2.joins.p6" value="true"/>

    <property name="token.count" value="30"/>
    <property name="workflow.completion.seconds" value="20"/>

    <!-- Hosts used by either version -->
    <property name="run.p1" value="true"/>
    <property name="run.p2" value="true"/>
    <property name="run.p3" value="true"/>
    <property name="run.p4" value="true"/>
    <property name="run.p6" value="true"/>
    <property name="first.node" value="p1"/>

    <!-- The machines: InfrastructureDefinitionFolder/ThreeHost.json (-Dinfrastructure=SingleHost runs on one machine) -->
    <property name="infrastructure" value="ThreeHost"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
