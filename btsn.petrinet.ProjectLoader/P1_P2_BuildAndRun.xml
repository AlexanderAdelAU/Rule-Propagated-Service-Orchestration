<?xml version="1.0" encoding="UTF-8"?>
<!-- petrinet/Workflow/P1_P2_Deterministic_Workflow
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Run:     ant -f P1_P2_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f P1_P2_BuildAndRun.xml analyse -->
<project name="P1_P2_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="petrinet/Workflow/P1_P2_Deterministic_Workflow"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/models/Deployment.json"/>
    <property name="workflow.process.name" value="petrinet/Workflow/P1_P2_Deterministic_Workflow"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001"/>

    <!-- Tokens: one block per event generator, each with its own rule version. -->
    <property name="eg1.id" value="P1_EVENTGENERATOR"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.tokens" value="10"/>
    <property name="eg1.data" value="outcome=true"/>
    <property name="token.count" value="10"/>
    <property name="workflow.completion.seconds" value="5"/>

    <!-- Hosts used by the service deployment: nodes of the infrastructure, each running the host program -->
    <property name="hosts" value="P1,P2"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
