<?xml version="1.0" encoding="UTF-8"?>
<!-- Launcher for petrinet/Workflow/P1_to_P6_Double_Join_Workflow, on the shared process runtime.
     The shared phases live in btsn.services/process-runtime.xml.
     Run:     ant -f P1_to_P6_Double_Join_Workflow.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f P1_to_P6_Double_Join_Workflow.xml analyse -->
<project name="P1_to_P6_Double_Join_Workflow" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="petrinet/Workflow/P1_to_P6_Double_Join_Workflow"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/models/DoubleJoinDeployment.json"/>
    <property name="workflow.process.name" value="petrinet/Workflow/P1_to_P6_Double_Join_Workflow"/>
    <property name="init.process.name" value="common/Initializers/P1_to_P6_Initialization"/>
    <property name="collector.process.name" value="common/Collectors/P1_to_P6_Collector"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001"/>

    <!-- Tokens -->
    <property name="eg1.id" value="EVENT_GENERATOR"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.data" value="outcome=true"/>
    <property name="token.count" value="10"/>
    <property name="workflow.completion.seconds" value="5"/>

    <!-- Hosts used by the service deployment -->
    <property name="run.p1" value="true"/>
    <property name="run.p2" value="true"/>
    <property name="run.p3" value="true"/>
    <property name="run.p4" value="true"/>
    <property name="run.p5" value="true"/>
    <property name="run.p6" value="true"/>
    <property name="first.node" value="p1"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
