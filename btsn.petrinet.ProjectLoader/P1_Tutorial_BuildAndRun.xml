<?xml version="1.0" encoding="UTF-8"?>
<!-- petrinet/Workflow/P1_Tutorial_Workflow: the single-place loop on P1 (true ends a workflow, false returns it to T_in_P1)
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Tokens follow the version's schedule, EventTriggeringFile/V001_EventTriggeringFile.csv.
     Run:     ant -f P1_Tutorial_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f P1_Tutorial_BuildAndRun.xml analyse
     P1_Tutorial_Local_BuildAndRun.xml runs this launcher on one computer and exports the tutorial's results. -->
<project name="P1_Tutorial_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="petrinet/Workflow/P1_Tutorial_Workflow"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/models/StochasticLoopDeployment.json"/>
    <property name="workflow.process.name" value="petrinet/Workflow/P1_Tutorial_Workflow"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001"/>

    <!-- Tokens: one block per event generator, each with its own rule version. -->
    <property name="eg1.id" value="P1_EVENTGENERATOR"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.tokens" value="10"/>
    <property name="token.count" value="10"/>

    <!-- Hosts used by the service deployment: nodes of the infrastructure, each running the host program -->
    <property name="hosts" value="P1"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
