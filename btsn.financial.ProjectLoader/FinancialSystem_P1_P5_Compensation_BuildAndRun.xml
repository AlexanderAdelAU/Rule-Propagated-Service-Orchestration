<?xml version="1.0" encoding="UTF-8"?>
<!-- Loan applications (v001) and a separate compensation process (v002) that the loan process starts itself, on the
     shared process runtime (btsn.services/process-runtime.xml).
     The fraud bureau is unavailable for about 1 application in 5 (FraudCheckService): its credit check has already
     recorded an enquiry, and underwriting, without a fraud result, abandons it. The loan process's Signal node "Loan Abandoned" then ends the
     application and launches the compensation process for it, which withdraws the enquiry where it was recorded (P2).
     Nothing audits the applications that went well: only an abandoned application starts compensation.
     Run:     ant -f FinancialSystem_P1_P5_Compensation_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f FinancialSystem_P1_P5_Compensation_BuildAndRun.xml analyse   (the usual report, then the compensation balance) -->
<project name="FinancialSystem_P1_P5_Compensation_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="Loan applications (v001) with a loan compensation process (v002)"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/financial/Deployment.json"/>
    <property name="workflow.process.name" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001,v002"/>
    <property name="token.count" value="10"/>

    <!-- The loan applications, one a second: each lives 20 s (eg1.expire), ample for one to be processed. -->
    <property name="eg1.id" value="EVENT_GENERATOR"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.data" value="application_id=APP001,annual_income=85000,requested_amount=25000,credit_score=720,fraud_risk=low"/>
    <property name="eg1.expire" value="20000"/>
    <property name="eg1.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/FinancialSystem_P1_P5_Compensation_BuildAndRun.csv"/>

    <!-- The compensation process: deployed as v002 but fired by nothing here. The loan process's Signal node starts it
         at its start node (Loan Abandoned), one token per abandoned application, each living 20 s. -->
    <property name="eg2.id" value="LOAN_ABANDONED"/>
    <property name="eg2.version" value="v002"/>
    <property name="eg2.process" value="financial/Workflow/Loan_Compensation_Workflow"/>
    <property name="eg2.place" value="P2_Place"/>
    <property name="eg2.operation" value="withdrawEnquiry"/>
    <property name="eg2.expire" value="20000"/>
    <property name="eg2.started.by.signal" value="true"/>

    <!-- Hosts used by the service deployment: nodes of the infrastructure, each running the host program -->
    <property name="hosts" value="P1,P2,P3,P4,P5"/>

    <import file="../btsn.services/process-runtime.xml"/>

    <!-- The usual analysis, then the balance of credit enquiries across the two processes: each enquiry the loan
         process's credit check opened (v001 T_out_P2) must be settled by underwriting (v001 T_out_P4 with any decision
         but abandoned) or withdrawn by the compensation process (v002 T_out_P2, arc withdrawn), exactly once. -->
    <target name="analyse" depends="launcher-jar-runtime-support.analyse" description="Analyse the Monitor database, then check the compensation balance">
        <java classname="org.btsn.derby.Analysis.CompensationBalance" fork="true" failonerror="true" dir="${monitor.project.dir}">
            <classpath refid="monitor.classpath"/>
            <arg value="resource=credit enquiry"/>
            <arg value="opened=v001:T_out_P2"/>
            <arg value="settled=v001:T_out_P4:!abandoned"/>
            <arg value="undone=v002:T_out_P2:withdrawn"/>
        </java>
    </target>
</project>
