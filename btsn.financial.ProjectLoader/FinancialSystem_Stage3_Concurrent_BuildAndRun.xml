<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage 3: full loan workflow (v001) and pre-screen workflow (v002) sharing the same services
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Run:     ant -f FinancialSystem_Stage3_Concurrent_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f FinancialSystem_Stage3_Concurrent_BuildAndRun.xml analyse -->
<project name="FinancialSystem_Stage3_Concurrent_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="Stage 3: full loan workflow (v001) and pre-screen workflow (v002) sharing the same services"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/financial/Deployment.json"/>
    <property name="workflow.process.name" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001,v002"/>

    <!-- Tokens: one block per event generator, each with its own rule version. The generators fire together. -->
    <property name="eg1.id" value="APPLICATION_SUBMITTED"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.process" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.tokens" value="10"/>
    <property name="eg1.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/Stage3_V001_Concurrent.csv"/>
    <property name="eg1.data" value="application_id=LOAN-STAGE3,annual_income=85000,requested_amount=25000,credit_score=720,fraud_risk=low"/>
    <property name="eg2.id" value="PRESCREEN_SUBMITTED"/>
    <property name="eg2.version" value="v002"/>
    <property name="eg2.process" value="financial/Workflow/FinancialSystem_Stage3_PreScreen_Workflow"/>
    <property name="eg2.place" value="P1_Place"/>
    <property name="eg2.operation" value="processToken"/>
    <property name="eg2.tokens" value="10"/>
    <property name="eg2.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/Stage3_V002_Concurrent.csv"/>
    <property name="eg2.data" value="application_id=PRESCREEN-STAGE3,annual_income=90000,requested_amount=22000,credit_score=680,fraud_risk=low"/>
    <property name="token.count" value="10"/>
    <property name="workflow.completion.seconds" value="12"/>

    <!-- Hosts used by the service deployment: nodes of the infrastructure, each running the host program -->
    <property name="hosts" value="P1,P2,P3,P4,P5"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
