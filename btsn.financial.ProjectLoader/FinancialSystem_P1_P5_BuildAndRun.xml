<?xml version="1.0" encoding="UTF-8"?>
<!-- Launcher for financial/Workflow/FinancialSystem_P1_P5_Workflow, on the shared process runtime.
     The shared phases live in btsn.services/process-runtime.xml.
     Run:     ant -f FinancialSystem_P1_P5_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f FinancialSystem_P1_P5_BuildAndRun.xml analyse -->
<project name="FinancialSystem_P1_P5_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/financial/Deployment.json"/>
    <property name="workflow.process.name" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001"/>

    <!-- Tokens -->
    <property name="eg1.id" value="EVENT_GENERATOR"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.data" value="application_id=APP001,annual_income=85000,requested_amount=25000,credit_score=720,fraud_risk=low"/>
    <property name="token.count" value="10"/>
    <property name="workflow.completion.seconds" value="5"/>

    <!-- Hosts used by the service deployment: nodes of the infrastructure, each running the host program -->
    <property name="hosts" value="P1,P2,P3,P4,P5"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
