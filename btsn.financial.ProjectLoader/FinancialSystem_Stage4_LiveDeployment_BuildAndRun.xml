<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage 4: the pre-screen workflow (v002) is published live while the loan workflow (v001) runs
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Run:     ant -f FinancialSystem_Stage4_LiveDeployment_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f FinancialSystem_Stage4_LiveDeployment_BuildAndRun.xml analyse -->
<project name="FinancialSystem_Stage4_LiveDeployment_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="Stage 4: the pre-screen workflow (v002) is published live while the loan workflow (v001) runs"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/financial/Deployment.json"/>
    <property name="workflow.process.name" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="init.process.name" value="common/Initializers/P1_P2_P3_P4_P5_Initialization"/>
    <property name="collector.process.name" value="common/Collectors/P1_P2_P3_P4_P5_Collector"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001,v002"/>

    <!-- Tokens: one block per event generator, each with its own rule version. v001 is deployed at the start and fires 3 s later; v002 is published to the running hosts at once and fires after every host commits. -->
    <property name="eg1.id" value="APPLICATION_SUBMITTED"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.process" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.tokens" value="10"/>
    <property name="eg1.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/Stage4_V001_LiveDeployment.csv"/>
    <property name="eg1.data" value="application_id=LOAN-STAGE4,annual_income=85000,requested_amount=25000,credit_score=720,fraud_risk=low"/>
    <property name="eg1.fire.after.seconds" value="3"/>
    <property name="eg2.id" value="PRESCREEN_SUBMITTED"/>
    <property name="eg2.version" value="v002"/>
    <property name="eg2.process" value="financial/Workflow/FinancialSystem_Stage3_PreScreen_Workflow"/>
    <property name="eg2.place" value="P1_Place"/>
    <property name="eg2.operation" value="processToken"/>
    <property name="eg2.tokens" value="10"/>
    <property name="eg2.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/Stage4_V002_LiveDeployment.csv"/>
    <property name="eg2.data" value="application_id=PRESCREEN-STAGE4,annual_income=90000,requested_amount=22000,credit_score=680,fraud_risk=low"/>
    <property name="eg2.publish.at.seconds" value="0"/>
    <property name="token.count" value="10"/>
    <property name="workflow.completion.seconds" value="12"/>

    <!-- Hosts used by the service deployment -->
    <property name="run.p1" value="true"/>
    <property name="run.p2" value="true"/>
    <property name="run.p3" value="true"/>
    <property name="run.p4" value="true"/>
    <property name="run.p5" value="true"/>
    <property name="first.node" value="p1"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
