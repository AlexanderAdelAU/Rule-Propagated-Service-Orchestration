<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage 5: background pre-screen workflow (v002, 40 tokens) with an urgent loan burst (v001, 15 tokens) 10 s later
     On the shared process runtime: the phases live in btsn.services/process-runtime.xml.
     Run:     ant -f FinancialSystem_Stage5_PriorityPreemption_BuildAndRun.xml        (add -Dhost.address=127.0.0.1 to run every host on this machine)
     Analyse: ant -f FinancialSystem_Stage5_PriorityPreemption_BuildAndRun.xml analyse -->
<project name="FinancialSystem_Stage5_PriorityPreemption_BuildAndRun" default="run-complete-workflow" basedir=".">
    <property name="process.title" value="Stage 5: background pre-screen workflow (v002, 40 tokens) with an urgent loan burst (v001, 15 tokens) 10 s later"/>
    <property name="launcher.profile.file" location="../btsn.services/deployments/financial/Deployment.json"/>
    <property name="workflow.process.name" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="init.process.name" value="common/Initializers/P1_P2_P3_P4_P5_Initialization"/>
    <property name="collector.process.name" value="common/Collectors/P1_P2_P3_P4_P5_Collector"/>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="v001,v002"/>

    <!-- Tokens: one block per event generator, each with its own rule version. Both versions are deployed at the
         start; v002 fires at once and v001 fires 10 s later. -->
    <property name="eg1.id" value="APPLICATION_SUBMITTED"/>
    <property name="eg1.version" value="v001"/>
    <property name="eg1.process" value="financial/Workflow/FinancialSystem_P1_P5_Workflow"/>
    <property name="eg1.place" value="P1_Place"/>
    <property name="eg1.operation" value="processToken"/>
    <property name="eg1.tokens" value="15"/>
    <property name="eg1.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/Stage5_V001_Urgent.csv"/>
    <property name="eg1.data" value="application_id=LOAN-STAGE5-URGENT,annual_income=85000,requested_amount=25000,credit_score=720,fraud_risk=low"/>
    <property name="eg1.fire.after.seconds" value="10"/>
    <property name="eg2.id" value="PRESCREEN_SUBMITTED"/>
    <property name="eg2.version" value="v002"/>
    <property name="eg2.process" value="financial/Workflow/FinancialSystem_Stage3_PreScreen_Workflow"/>
    <property name="eg2.place" value="P1_Place"/>
    <property name="eg2.operation" value="processToken"/>
    <property name="eg2.tokens" value="40"/>
    <property name="eg2.trigger.file" location="../btsn.common.eventgenerators/EventTriggeringFile/Stage5_V002_Background.csv"/>
    <property name="eg2.data" value="application_id=PRESCREEN-STAGE5-BACKGROUND,annual_income=90000,requested_amount=22000,credit_score=680,fraud_risk=low"/>
    <property name="token.count" value="40"/>
    <property name="workflow.completion.seconds" value="25"/>

    <!-- Hosts used by the service deployment -->
    <property name="run.p1" value="true"/>
    <property name="run.p2" value="true"/>
    <property name="run.p3" value="true"/>
    <property name="run.p4" value="true"/>
    <property name="run.p5" value="true"/>
    <property name="first.node" value="p1"/>

    <import file="../btsn.services/process-runtime.xml"/>
</project>
