<?xml version="1.0" encoding="UTF-8"?>
<project name="service-deployment" default="package" basedir=".">
    <!-- Ant 1.10.2+ running on JDK 15+. No external build tool is invoked. -->
    <property name="packaging.config" location="packaging.json"/>
    <property name="target.dir" location="target"/>
    <property name="java.release" value="15"/>
    <property name="common.dir" location="../btsn.common"/>
    <path id="inventory.classpath">
        <pathelement location="${target.dir}/tools"/>
        <pathelement location="${common.dir}/lib/json-simple-1.1.1.jar"/>
    </path>
    <target name="clean" description="Remove generated service module output">
        <delete dir="${target.dir}"/>
    </target>
    <target name="inventory" description="Read catalogue data and generate native Ant packaging tasks">
        <delete dir="${target.dir}/inventory"/>
        <delete dir="${target.dir}/tools"/>
        <mkdir dir="${target.dir}/tools"/>
        <javac srcdir="src" destdir="${target.dir}/tools" release="${java.release}"
               includeantruntime="false" encoding="UTF-8">
            <classpath refid="inventory.classpath"/>
        </javac>
        <java classname="org.btsn.packaging.ServiceInventory" fork="true" failonerror="true">
            <classpath refid="inventory.classpath"/>
            <arg value="generate"/><arg file="${packaging.config}"/><arg file="${target.dir}"/><arg file="${basedir}"/>
        </java>
    </target>
    <target name="package" depends="inventory" description="Compile service JARs and deployment ZIP with Ant">
        <ant antfile="${target.dir}/service-tasks.xml" target="package" inheritall="false"/>
        <echo>Deployment bundle: ${target.dir}/service-deployment.zip</echo>
    </target>
    <target name="runtime" depends="package" description="Build shared host infrastructure without embedded service classes">
        <ant antfile="infrastructure.xml" target="jar" inheritall="false"/>
    </target>
    <target name="check-model-services" depends="package" description="Check deterministic model outcomes using packaged service JARs">
        <mkdir dir="${target.dir}/model-check"/>
        <path id="model.check.classpath">
            <pathelement location="${target.dir}/model-check"/>
            <fileset dir="${target.dir}/deployment/services" includes="*.jar"/>
            <fileset dir="${target.dir}/deployment/lib" includes="*.jar"/>
        </path>
        <javac srcdir="tests" destdir="${target.dir}/model-check" includes="DeterministicModelServiceCheck.java"
               release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="model.check.classpath"/>
        </javac>
        <java classname="DeterministicModelServiceCheck" fork="true" failonerror="true">
            <classpath refid="model.check.classpath"/>
        </java>
    </target>
    <target name="build-hosts" depends="runtime" description="Build all six generic hosts against the same service JARs">
        <ant antfile="../btsn.petrinet.places.p1/build.xml" target="jar-only" inheritall="false"/>
        <ant antfile="../btsn.petrinet.places.p2/build.xml" target="jar-only" inheritall="false"/>
        <ant antfile="../btsn.petrinet.places.p3/build.xml" target="jar-only" inheritall="false"/>
        <ant antfile="../btsn.petrinet.places.p4/build.xml" target="jar-only" inheritall="false"/>
        <ant antfile="../btsn.petrinet.places.p5/build.xml" target="jar-only" inheritall="false"/>
        <ant antfile="../btsn.petrinet.places.p6/build.xml" target="jar-only" inheritall="false"/>
    </target>
    <target name="check-healthcare-services" depends="package" description="Check healthcare results, direct treatment and federated audit fields using JARs">
        <mkdir dir="${target.dir}/healthcare-check"/>
        <delete dir="${target.dir}/healthcare-check/runtime"/>
        <mkdir dir="${target.dir}/healthcare-check/runtime"/>
        <path id="healthcare.check.classpath">
            <pathelement location="${target.dir}/healthcare-check"/>
            <fileset dir="${target.dir}/deployment/services" includes="*.jar"/>
            <fileset dir="${target.dir}/deployment/lib" includes="*.jar"/>
        </path>
        <javac srcdir="tests" destdir="${target.dir}/healthcare-check" includes="HealthcareServiceCheck.java"
               release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="healthcare.check.classpath"/>
        </javac>
        <java classname="HealthcareServiceCheck" fork="true" failonerror="true" maxmemory="128m" dir="${target.dir}/healthcare-check/runtime">
            <classpath refid="healthcare.check.classpath"/>
        </java>
    </target>
    <target name="build-workflow-runtime" depends="build-hosts" description="Build packaged hosts, Monitor and event generators">
        <ant antfile="workflow-runtime.xml" target="jar" inheritall="false"/>
    </target>
    <target name="check-hosts" depends="build-workflow-runtime" description="Verify real host JAR classpaths and invoke services on every host">
        <delete dir="${target.dir}/host-check"/>
        <mkdir dir="${target.dir}/host-check/classes"/>
        <mkdir dir="${target.dir}/host-check/empty-sourcepath"/>
        <path id="host.check.dependencies">
            <pathelement location="${common.dir}/target/host-runtime/btsn-infrastructure.jar"/>
            <fileset dir="${target.dir}/deployment/services" includes="*.jar"/>
            <fileset dir="${target.dir}/deployment/lib" includes="*.jar"/>
            <fileset dir="${common.dir}/lib" includes="*.jar" excludesfile="${target.dir}/runtime-library-excludes.txt"/>
        </path>
        <javac destdir="${target.dir}/host-check/classes" release="${java.release}"
               sourcepath="${target.dir}/host-check/empty-sourcepath" includeantruntime="false" encoding="UTF-8">
            <src path="tests"/><src path="${common.dir}/tests"/>
            <include name="HostClasspathCheck.java"/>
            <include name="org/btsn/invocation/BusinessCapabilityResolverTest.java"/>
            <classpath>
                <pathelement location="../btsn.petrinet.places.p1/target/btsn.petrinet.places.p1.jar"/>
                <path refid="host.check.dependencies"/>
            </classpath>
        </javac>
        <macrodef name="check-host">
            <attribute name="number"/>
            <sequential>
                <mkdir dir="${target.dir}/host-check/p@{number}"/>
                <java classname="HostClasspathCheck" fork="true" failonerror="true">
                    <classpath>
                        <pathelement location="${target.dir}/host-check/classes"/>
                        <pathelement location="../btsn.petrinet.places.p@{number}/target/btsn.petrinet.places.p@{number}.jar"/>
                        <path refid="host.check.dependencies"/>
                    </classpath>
                    <arg file="${target.dir}/deployment"/>
                    <arg file="../btsn.petrinet.places.p@{number}/target/btsn.petrinet.places.p@{number}.jar"/>
                    <arg file="${common.dir}/target/host-runtime/btsn-infrastructure.jar"/>
                </java>
                <java classname="org.btsn.invocation.BusinessCapabilityResolverTest" fork="true" failonerror="true"
                      dir="${target.dir}/host-check/p@{number}">
                    <classpath>
                        <pathelement location="${target.dir}/host-check/classes"/>
                        <pathelement location="../btsn.petrinet.places.p@{number}/target/btsn.petrinet.places.p@{number}.jar"/>
                        <path refid="host.check.dependencies"/>
                    </classpath>
                    <arg file="${common.dir}"/>
                    <arg value="org.btsn.places.P@{number}_Place"/>
                </java>
            </sequential>
        </macrodef>
        <check-host number="1"/><check-host number="2"/><check-host number="3"/>
        <check-host number="4"/><check-host number="5"/><check-host number="6"/>
    </target>
    <target name="check" depends="package" description="Check isolated JARs and all six invocation boundaries">
        <ant antfile="${target.dir}/service-tasks.xml" target="check" inheritall="false"/>
        <antcall target="check-resolver"/>
    </target>
    <target name="check-resolver" description="Run existing invocation checks using packaged service implementations">
        <delete dir="${target.dir}/resolver-check"/>
        <mkdir dir="${target.dir}/resolver-check/classes"/>
        <mkdir dir="${target.dir}/resolver-check/empty-sourcepath"/>
        <path id="packaged.classpath">
            <fileset dir="${target.dir}/deployment/services" includes="*.jar"/>
            <fileset dir="${target.dir}/deployment/lib" includes="*.jar"/>
        </path>
        <path id="resolver.classpath">
            <pathelement location="${target.dir}/resolver-check/classes"/>
            <path refid="packaged.classpath"/>
        </path>
        <javac destdir="${target.dir}/resolver-check/classes" release="${java.release}"
               sourcepath="${target.dir}/resolver-check/empty-sourcepath" includeantruntime="false" encoding="UTF-8">
            <src path="${common.dir}/src"/><src path="${common.dir}/tests"/>
            <src path="../btsn.petrinet.places.p1/src"/>
            <include name="org/btsn/invocation/BusinessCapabilityResolver.java"/>
            <include name="org/btsn/invocation/BusinessCapabilityResolverTest.java"/>
            <include name="org/btsn/json/jsonLibrary.java"/>
            <include name="org/btsn/handlers/ServiceHelper.java"/>
            <classpath refid="packaged.classpath"/>
        </javac>
        <macrodef name="check-helper">
            <attribute name="number"/>
            <sequential>
                <mkdir dir="${target.dir}/resolver-check/p@{number}"/>
                <javac srcdir="../btsn.petrinet.places.p@{number}/src"
                       destdir="${target.dir}/resolver-check/p@{number}" release="${java.release}"
                       sourcepath="${target.dir}/resolver-check/empty-sourcepath" includeantruntime="false" encoding="UTF-8">
                    <include name="org/btsn/handlers/ServiceHelper.java"/>
                    <classpath refid="resolver.classpath"/>
                </javac>
                <java classname="org.btsn.packaging.ServiceInventory" fork="true" failonerror="true">
                    <classpath refid="inventory.classpath"/>
                    <arg value="same-file"/>
                    <arg file="../btsn.petrinet.places.p1/src/org/btsn/handlers/ServiceHelper.java"/>
                    <arg file="../btsn.petrinet.places.p@{number}/src/org/btsn/handlers/ServiceHelper.java"/>
                </java>
            </sequential>
        </macrodef>
        <check-helper number="2"/><check-helper number="3"/><check-helper number="4"/>
        <check-helper number="5"/><check-helper number="6"/>
        <java classname="org.btsn.invocation.BusinessCapabilityResolverTest" fork="true" failonerror="true"
              dir="${target.dir}/resolver-check">
            <classpath refid="resolver.classpath"/><arg file="${common.dir}"/>
        </java>
        <echo>PASS: all six invocation boundaries checked with services loaded exclusively from JARs</echo>
    </target>
</project>
