    <target name="check-healthcare-names" depends="jar" description="Read-only naming check after the default ten-patient healthcare run">
        <mkdir dir="target/healthcare-names-check/classes"/>
        <path id="healthcare.names.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/healthcare-names-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/healthcare-names-check/classes"
               includes="ServiceNamingRuntimeCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="healthcare.names.check.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.ServiceNamingRuntimeCheck" fork="true" failonerror="true"
              dir="../btsn.common.Monitor" maxmemory="128m">
            <classpath refid="healthcare.names.check.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
    </target>
</project>
