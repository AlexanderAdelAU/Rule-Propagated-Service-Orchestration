<?xml version="1.0" encoding="UTF-8"?>
<project name="workflow-analysis-checks" default="check-analysis" basedir="../..">
    <target name="check-circulating-timings" depends="jar" description="Check stopped local service measurements without Monitor or completion records">
        <delete dir="target/circulating-timings-check"/>
        <mkdir dir="target/circulating-timings-check/classes"/>
        <tempfile property="circulating.timings.runtime" destdir="${java.io.tmpdir}" prefix="btsn-circulating-"/>
        <mkdir dir="${circulating.timings.runtime}"/>
        <path id="circulating.timings.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/circulating-timings-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/circulating-timings-check/classes"
               includes="CirculatingServiceTimingsCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="circulating.timings.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.CirculatingServiceTimingsCheck" fork="true" failonerror="true"
              dir="${circulating.timings.runtime}">
            <classpath refid="circulating.timings.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
    </target>
    <target name="check-process-labels" depends="jar" description="Check captured process names against exact GENERATED observations and chart exports">
        <delete dir="target/process-labels-check"/>
        <mkdir dir="target/process-labels-check/classes"/>
        <mkdir dir="target/process-labels-check/runtime"/>
        <path id="process.labels.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="../btsn.common.eventgenerators/target/jar-runtime/btsn-eventgenerators.jar"/>
            <pathelement location="target/process-labels-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/process-labels-check/classes"
               includes="WorkflowProcessNamesCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="process.labels.check.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.WorkflowProcessNamesCheck" fork="true" failonerror="true"
              dir="target/process-labels-check/runtime" maxmemory="128m">
            <classpath refid="process.labels.check.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <arg file="../btsn.common.Monitor"/>
        </java>
    </target>
    <target name="check-analysis" depends="jar" description="Check recorded-event reconstruction of single and double joins">
        <delete dir="target/analysis-check"/>
        <mkdir dir="target/analysis-check/classes"/>
        <mkdir dir="target/analysis-check/runtime"/>
        <path id="analysis.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/analysis-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/analysis-check/classes"
               includes="DoubleJoinAnalysisCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="analysis.check.classpath"/>
        </javac>
        <java classname="DoubleJoinAnalysisCheck" fork="true" failonerror="true" dir="target/analysis-check/runtime" maxmemory="128m">
            <classpath refid="analysis.check.classpath"/>
        </java>
    </target>
    <target name="check-service-names" depends="jar" description="Check business labels without changing physical identities or measurements">
        <delete dir="target/service-names-check"/>
        <mkdir dir="target/service-names-check/classes"/>
        <mkdir dir="target/service-names-check/runtime"/>
        <path id="service.names.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/service-names-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/service-names-check/classes"
               includes="ServiceNamingAnalysisCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="service.names.check.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.ServiceNamingAnalysisCheck" fork="true" failonerror="true"
              dir="target/service-names-check/runtime" maxmemory="128m">
            <classpath refid="service.names.check.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <arg file="${common.dir}"/>
        </java>
    </target>
