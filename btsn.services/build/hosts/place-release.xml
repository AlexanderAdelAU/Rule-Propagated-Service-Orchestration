<?xml version="1.0" encoding="UTF-8"?>
<!-- Used by one numbered place at a time. No other place or business build is invoked. -->
<project name="individual-place-release-support" basedir="../..">
    <property name="host.address" value=""/>
    <property name="place.release.root" location="${host.target}/release"/>
    <property name="place.release.dir" location="${place.release.root}/${host.artifact}"/>
    <property name="place.release.jar" location="${place.release.dir}/${host.artifact}.jar"/>
    <property name="place.release.zip" location="${host.target}/${host.artifact}.zip"/>
    <path id="place.compile.dependencies"><fileset dir="${common.dir}/lib" includes="*.jar"/></path>
    <target name="place-compile" description="Compile this place and shared infrastructure only">
        <delete dir="${host.target}/place-classes"/>
        <mkdir dir="${host.target}/place-classes"/>
        <mkdir dir="${host.target}/place-empty-sourcepath"/>
        <javac destdir="${host.target}/place-classes" release="${java.release}" includeantruntime="false"
               sourcepath="${host.target}/place-empty-sourcepath" encoding="UTF-8">
            <src path="${common.dir}/src"/><src path="${basedir}/src"/>
            <exclude name="org/btsn/business/**"/>
            <exclude name="org/btsn/services/**"/>
            <exclude name="org/btsn/base/BaseStochasticPetriNetPlace*.java"/>
            <exclude name="org/btsn/base/BaseBusinessPetriNetPlace.java"/>
            <exclude name="org/btsn/base/BaseHealthcareService.java"/>
            <exclude name="org/btsn/base/BaseServiceAssessment.java"/>
            <exclude name="org/btsn/base/ServiceAssessment.java"/>
            <classpath refid="place.compile.dependencies"/>
        </javac>
        <copy todir="${host.target}/place-classes"><fileset dir="${common.dir}/src" excludes="**/*.java,**/*.class,org/btsn/business/**,org/btsn/services/**"/></copy>
        <copy todir="${host.target}/place-classes"><fileset dir="${basedir}/src" excludes="**/*.java,**/*.class"/></copy>
    </target>
    <target name="place-release" depends="place-compile" description="Package this place's executable JAR, dependencies, configuration and manual launch commands">
        <delete dir="${place.release.root}"/>
        <delete file="${host.target}/btsn-services.zip"/>
        <mkdir dir="${place.release.dir}/lib"/>
        <copy todir="${place.release.dir}/lib"><fileset dir="${common.dir}/lib" includes="*.jar"/></copy>
        <manifestclasspath property="place.release.classpath" jarfile="${place.release.jar}">
            <classpath><fileset dir="${place.release.dir}/lib" includes="*.jar"/></classpath>
        </manifestclasspath>
        <jar destfile="${place.release.jar}" basedir="${host.target}/place-classes" modificationtime="315532800000">
            <manifest>
                <attribute name="Main-Class" value="org.btsn.handlers.ServiceLoader"/>
                <attribute name="Class-Path" value="${place.release.classpath}"/>
            </manifest>
        </jar>
        <copy todir="${place.release.root}/btsn.common">
            <fileset dir="${common.dir}" includes="RuleBase/**,ServiceAttributeBindings/**,BusinessServiceDefinitions/**,ProcessDefinitionFolder/**,InfrastructureDefinitionFolder/**,ServiceDeploymentFolder/**,PayLoad/**"/>
        </copy>
        <java classname="org.btsn.deployment.GenerateDeploymentRules" fork="true" failonerror="true">
            <classpath><pathelement location="${host.target}/place-classes"/><path refid="place.compile.dependencies"/></classpath>
            <arg file="${place.release.root}/btsn.common"/><arg value="${host.address}"/>
        </java>
        <copy todir="${place.release.dir}">
            <fileset dir="${basedir}" includes="ServiceLoaderQueries/**,RuleFolder.*/**,resources/**,PayLoad/**" excludes="**/*.class,**/*.log"/>
        </copy>
        <echo file="${place.release.root}/launch.bat">@echo off
cd /d "%~dp0${host.artifact}"
java -jar ${host.artifact}.jar -version v001 %*
</echo>
        <echo file="${place.release.root}/launch.sh">#!/bin/sh
cd "$(dirname "$0")/${host.artifact}" || exit 1
exec java -jar ${host.artifact}.jar -version v001 "$@"
</echo>
        <echo file="${place.release.root}/README.txt">${host.artifact} independent infrastructure release

Copy this ZIP to the destination machine and extract the entire ZIP into its own writable folder.
Windows: run launch.bat
Linux/macOS: run sh launch.sh
Java 15+ must be installed. Ant and the source repository are not required there.

The executable JAR is ${host.artifact}/${host.artifact}.jar.
Keep its lib folder, service configuration and sibling btsn.common folder with it.
To start it directly, open a terminal in ${host.artifact} and run:
java -jar ${host.artifact}.jar -version v001

This package contains only this numbered place, shared infrastructure and external libraries.
It does not contain any business implementation JAR or another numbered place.
Business-service builds, launches and the separate invocation boundary are outside this step.
The existing ServiceLoader, ServiceThread and ServiceHelper have not been changed.

Set the existing channel/deployment address mappings for the destination before startup.
The launch command starts this place's configured service and rule-handler threads.
Then deploy process rules through the normal Ant deployment on the development machine.
Close the console or press Ctrl+C to stop this program.
</echo>
        <fixcrlf srcdir="${place.release.root}" includes="launch.bat" eol="crlf"/>
        <delete file="${place.release.zip}"/>
        <zip destfile="${place.release.zip}" modificationtime="315532800000">
            <zipfileset dir="${place.release.root}" excludes="launch.sh"/>
            <zipfileset dir="${place.release.root}" includes="launch.sh" filemode="755"/>
        </zip>
        <echo>Independent executable JAR: ${place.release.jar}</echo>
        <echo>Independent place ZIP: ${place.release.zip}</echo>
    </target>
    <target name="check-release" depends="place-release" description="Start this place from its extracted ZIP without a source checkout or business JARs">
        <mkdir dir="${host.target}/place-check"/>
        <javac srcdir="${services.dir}/tests" destdir="${host.target}/place-check" includes="IndividualPlaceReleaseCheck.java"
               release="${java.release}" includeantruntime="false"/>
        <java classname="IndividualPlaceReleaseCheck" fork="true" failonerror="true">
            <classpath><pathelement location="${host.target}/place-check"/></classpath>
            <arg file="${basedir}/.."/><arg value="${host.artifact}"/>
        </java>
    </target>
</project>
