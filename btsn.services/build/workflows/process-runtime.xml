<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared phases for a single-process BuildAndRun launcher.

  A launcher sets its properties and imports ../btsn.services/process-runtime.xml (the
  ProcessEditor's "Create Build and Run" writes such launchers). The phases match the
  hand-written launchers:
    Phase 1  initialise the databases of the hosts in use and Monitor
    Phase 2  deploy the workflow rules for each event generator's version, then fire all generators together
    Phase 3  collect each host's records into Monitor

  Required launcher properties
    launcher.profile.file      deployment profile (catalogue + infrastructure + service deployment)
    workflow.process.name      process under ProcessDefinitionFolder, e.g. petrinet/Workflow/X
    init.process.name          initialiser covering the hosts in use
    collector.process.name     collector covering the hosts in use
    eg1.id, eg1.version, eg1.place, eg1.operation, eg1.trigger.file
                               one block per event generator (eg1 to eg3), each with its own rule
                               version so their tokens stay apart; query.version lists the versions
                               (e.g. v001,v002). A single-generator launcher may instead set
                               event.generator.id, target.place, target.operation, rule.version, trigger.file
    eg1.data                   optional: name=value pairs carried by every token of that generator,
                               e.g. outcome=true
    eg1.join.inputs            optional: the generator feeds a join with this many inputs; it fires one
                               workflow's join tokens, numbered from that version's base
    run.p1 ... run.p6          set for each host the deployment uses
    first.node                 first host in use (p1 ... p6); its calls deploy the admin rules
-->
<project name="process-runtime" default="run-complete-workflow" basedir="../.."
         xmlns:if="ant:if" xmlns:unless="ant:unless">

    <import file="launcher-runtime.xml"/>

    <property name="process.title" value="${workflow.process.name}"/>
    <!-- -Dinfrastructure=MultiHost selects InfrastructureDefinitionFolder/MultiHost.json; every profile defaults to SingleHost. -->
    <condition property="infrastructure.definition.name" value="${infrastructure}" else="SingleHost">
        <not><equals arg1="${infrastructure}" arg2=""/></not>
    </condition>
    <property name="rule.version" value="v001"/>
    <property name="query.version" value="${rule.version}"/>
    <property name="token.count" value="10"/>
    <property name="token.expire" value="120000"/>
    <property name="trigger.file" value=""/>

    <property name="p1.mode" value="auto"/>
    <property name="p2.mode" value="auto"/>
    <property name="p3.mode" value="auto"/>
    <property name="p4.mode" value="auto"/>
    <property name="p5.mode" value="auto"/>
    <property name="p6.mode" value="auto"/>
    <property name="monitor.mode" value="auto"/>

    <property name="init.version" value="v999"/>
    <property name="db.init.operation" value="purgeAndInitialize"/>
    <property name="collector.version" value="v999"/>
    <property name="collector.operation" value="collectAllData"/>

    <property name="service.startup.seconds" value="3"/>
    <property name="init.delay.seconds" value="3"/>
    <property name="phase.delay.seconds" value="5"/>
    <property name="workflow.completion.seconds" value="10"/>
    <property name="collector.delay.seconds" value="3"/>

    <property name="output.dir" location="${basedir}"/>
    <property name="monitor.output.file" location="${output.dir}/MonitorService.out.txt"/>

    <property name="service.loader.class" value="org.btsn.handlers.ServiceLoader"/>
    <property name="init.event.generator.class" value="org.btsn.common.eventgenerators.DatabaseInitialization_EventGenerator"/>
    <property name="token.generator.class" value="org.btsn.petrinet.eventgenerators.GenericPetriNetTokenGenerator"/>
    <property name="collector.event.generator.class" value="org.btsn.common.eventgenerators.Common_Collector_EventGenerator"/>

    <!-- Single-generator launchers name their generator with event.generator.id; it becomes eg1. -->
    <condition property="eg1.id" value="${event.generator.id}"><isset property="event.generator.id"/></condition>
    <property name="eg1.version" value="${rule.version}"/>
    <property name="eg1.place" value="${target.place}"/>
    <property name="eg1.operation" value="${target.operation}"/>
    <property name="eg1.trigger.file" value="${trigger.file}"/>
    <condition property="eg1.trigger.set"><and><isset property="eg1.id"/><not><equals arg1="${eg1.trigger.file}" arg2=""/></not></and></condition>
    <condition property="eg2.trigger.set"><and><isset property="eg2.trigger.file"/><not><equals arg1="${eg2.trigger.file}" arg2=""/></not></and></condition>
    <condition property="eg3.trigger.set"><and><isset property="eg3.trigger.file"/><not><equals arg1="${eg3.trigger.file}" arg2=""/></not></and></condition>
    <property name="${first.node}.first" value="true"/>
    <!-- Optional per generator: its own process definition (versions may differ by a rule delta), its own
         token count, and egN.publish.at.seconds to publish that version live, while the other generators run
         (egN.fire.after.seconds then waits between its commitment and its first token; for a version deployed
         at the start it delays that generator's first token). -->
    <property name="eg1.process" value="${workflow.process.name}"/>
    <property name="eg2.process" value="${workflow.process.name}"/>
    <property name="eg3.process" value="${workflow.process.name}"/>
    <property name="eg1.tokens" value="${token.count}"/>
    <property name="eg2.tokens" value="${token.count}"/>
    <property name="eg3.tokens" value="${token.count}"/>

    <!-- A host process for one node, started only when the deployment uses it and it runs here. -->
    <macrodef name="start-host">
        <attribute name="node"/><attribute name="label"/>
        <sequential>
            <echo message="  [@{node}] Skipping - running on remote host" if:set="run.@{node}" unless:set="@{node}.is.local"/>
            <java failonerror="true" classname="${service.loader.class}" if:set="@{node}.launch"
                  fork="true" timeout="600000" dir="${@{node}.project.dir}" output="${output.dir}/@{label}_Place.out.txt">
                <classpath refid="@{node}.classpath"/>
                <arg value="${@{node}.project.dir}"/>
                <arg value="-version"/><arg value="${rule.version}"/>
            </java>
        </sequential>
    </macrodef>

    <macrodef name="initialise-host">
        <attribute name="node"/><attribute name="service"/><attribute name="sequence"/>
        <sequential>
            <java classname="${init.event.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true" if:set="run.@{node}">
                <classpath refid="generator.classpath"/>
                <arg value="-service"/><arg value="@{service}"/>
                <arg value="-operation"/><arg value="${db.init.operation}"/>
                <arg value="-version"/><arg value="${init.version}"/>
                <arg value="-process"/><arg value="${init.process.name}"/>
                <arg value="-sequenceId"/><arg value="@{sequence}"/>
                <arg value="-tokens"/><arg value="1"/>
                <arg value="-skipDeploy" unless:set="@{node}.first"/>
            </java>
        </sequential>
    </macrodef>

    <macrodef name="collect-host">
        <attribute name="node"/><attribute name="service"/><attribute name="sequence"/>
        <sequential>
            <echo message="Collecting from @{service}..." if:set="run.@{node}"/>
            <java classname="${collector.event.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true" if:set="run.@{node}">
                <classpath refid="generator.classpath"/>
                <arg value="-service"/><arg value="@{service}"/>
                <arg value="-operation"/><arg value="${collector.operation}"/>
                <arg value="-version"/><arg value="${collector.version}"/>
                <arg value="-process"/><arg value="${collector.process.name}"/>
                <arg value="-queryVersion"/><arg value="${query.version}"/>
                <arg value="-sequenceId"/><arg value="@{sequence}"/>
                <arg value="-skipDeploy" unless:set="@{node}.first"/>
            </java>
            <sleep seconds="${collector.delay.seconds}" if:set="run.@{node}"/>
        </sequential>
    </macrodef>

    <macrodef name="resolve-host">
        <attribute name="node"/>
        <sequential>
            <resolve-local-launch component="@{node}" mode="${@{node}.mode}" if:set="run.@{node}"/>
            <condition property="@{node}.launch"><and><isset property="run.@{node}"/><isset property="@{node}.is.local"/></and></condition>
        </sequential>
    </macrodef>

    <target name="resolve-deployment-modes" depends="prepare-runtime,detect-local-channel">
        <resolve-host node="p1"/><resolve-host node="p2"/><resolve-host node="p3"/>
        <resolve-host node="p4"/><resolve-host node="p5"/><resolve-host node="p6"/>
        <resolve-local-launch component="monitor" mode="${monitor.mode}"/>
        <condition property="remote.hosts.present"><or>
            <and><isset property="run.p1"/><not><isset property="p1.is.local"/></not></and>
            <and><isset property="run.p2"/><not><isset property="p2.is.local"/></not></and>
            <and><isset property="run.p3"/><not><isset property="p3.is.local"/></not></and>
            <and><isset property="run.p4"/><not><isset property="p4.is.local"/></not></and>
            <and><isset property="run.p5"/><not><isset property="p5.is.local"/></not></and>
            <and><isset property="run.p6"/><not><isset property="p6.is.local"/></not></and>
        </or></condition>
        <echo message="Infrastructure: ${infrastructure.definition.name}"/>
    </target>

    <target name="clean-output" description="Remove the previous host output files">
        <delete quiet="true"><fileset dir="${output.dir}" includes="P?_Place.out.txt,MonitorService.out.txt"/></delete>
    </target>

    <!-- Bindings and master rules for one event generator's version (skipped when the slot is unused). -->
    <macrodef name="prepare-version">
        <attribute name="slot"/>
        <sequential>
            <java classname="org.btsn.rulecontroller.TopologyBindingGenerator" classpathref="generator.classpath"
                  dir="${common.project.dir}" fork="true" failonerror="true" if:set="@{slot}.id">
                <arg value="${@{slot}.process}"/><arg value="${@{slot}.version}"/>
            </java>
            <java classname="org.btsn.utils.BuildMasterServiceRuleBase" classpathref="generator.classpath"
                  dir="${common.project.dir}" fork="true" failonerror="true" if:set="@{slot}.id">
                <arg value="${@{slot}.version}"/><arg value="ALL"/>
            </java>
        </sequential>
    </macrodef>

    <!-- Deploy the process under one generator's version. -->
    <macrodef name="deploy-generator">
        <attribute name="slot"/>
        <sequential>
            <echo message="Deploying ${@{slot}.process} (${@{slot}.version}) for ${@{slot}.id}..." if:set="@{slot}.id"/>
            <java classname="${token.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true" if:set="@{slot}.id">
                <classpath refid="generator.classpath"/>
                <arg value="-version"/><arg value="${@{slot}.version}"/>
                <arg value="-process"/><arg value="${@{slot}.process}"/>
                <arg value="-infrastructure"/><arg value="${infrastructure.definition.name}"/>
                <arg value="-place"/><arg value="${@{slot}.place}"/>
                <arg value="-operation"/><arg value="${@{slot}.operation}"/>
                <arg value="-tokens"/><arg value="0"/>
                <arg value="-expire"/><arg value="${token.expire}"/>
                <arg value="-generator"/><arg value="${@{slot}.id}"/>
            </java>
        </sequential>
    </macrodef>

    <!-- Fire one generator's tokens on its schedule. -->
    <macrodef name="fire-generator">
        <attribute name="slot"/>
        <sequential>
            <echo message="Firing ${@{slot}.tokens} tokens from ${@{slot}.id} (${@{slot}.version}) to ${@{slot}.place}.${@{slot}.operation}..." if:set="@{slot}.id"/>
            <java classname="${token.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true" if:set="@{slot}.id">
                <classpath refid="generator.classpath"/>
                <arg value="-version"/><arg value="${@{slot}.version}"/>
                <arg value="-process"/><arg value="${@{slot}.process}"/>
                <arg value="-infrastructure"/><arg value="${infrastructure.definition.name}"/>
                <arg value="-place"/><arg value="${@{slot}.place}"/>
                <arg value="-operation"/><arg value="${@{slot}.operation}"/>
                <arg value="-tokens"/><arg value="${@{slot}.tokens}"/>
                <arg value="-expire"/><arg value="${token.expire}"/>
                <arg value="-generator"/><arg value="${@{slot}.id}"/>
                <arg value="-triggerfile" if:set="@{slot}.trigger.set"/><arg value="${@{slot}.trigger.file}" if:set="@{slot}.trigger.set"/>
                <arg value="-data" if:set="@{slot}.data"/><arg value="${@{slot}.data}" if:set="@{slot}.data"/>
                <arg value="-joininputs" if:set="@{slot}.join.inputs"/><arg value="${@{slot}.join.inputs}" if:set="@{slot}.join.inputs"/>
                <arg value="-skipdeploy"/>
            </java>
        </sequential>
    </macrodef>

    <!-- Versions published live (egN.publish.at.seconds) are compiled when they are published, not here:
         nothing about such a version exists before its publication. -->
    <target name="generate-workflow-bindings" depends="prepare-runtime" description="Generate canonical bindings and master rules for each version deployed at the start">
        <prepare-version slot="eg1" unless:set="eg1.publish.at.seconds"/>
        <prepare-version slot="eg2" unless:set="eg2.publish.at.seconds"/>
        <prepare-version slot="eg3" unless:set="eg3.publish.at.seconds"/>
    </target>

    <target name="rebuild-service-ruleml" depends="prepare-runtime,generate-workflow-bindings" description="Rebuild the master Service.ruleml (done per version above)"/>

    <!-- Versions published live are deployed later, by run-generator. -->
    <target name="deploy-workflow">
        <deploy-generator slot="eg1" unless:set="eg1.publish.at.seconds"/>
        <deploy-generator slot="eg2" unless:set="eg2.publish.at.seconds"/>
        <deploy-generator slot="eg3" unless:set="eg3.publish.at.seconds"/>
    </target>

    <!-- One generator's part of the run: a live version is published (and committed by every host) at its
         publish time, while the other generators keep firing; then its tokens fire. The [LIVE] lines time it. -->
    <macrodef name="run-generator">
        <attribute name="slot"/>
        <sequential>
            <sequential if:set="@{slot}.publish.at.seconds">
                <sleep seconds="${@{slot}.publish.at.seconds}"/>
                <tstamp><format property="@{slot}.publish.time" pattern="yyyy-MM-dd HH:mm:ss.SSS"/></tstamp>
                <echo message="[LIVE] ${@{slot}.version} publish started at ${@{slot}.publish.time} (${@{slot}.process})"/>
                <prepare-version slot="@{slot}"/>
                <deploy-generator slot="@{slot}"/>
                <tstamp><format property="@{slot}.commit.time" pattern="yyyy-MM-dd HH:mm:ss.SSS"/></tstamp>
                <echo message="[LIVE] ${@{slot}.version} committed by every host at ${@{slot}.commit.time}"/>
                <sleep seconds="${@{slot}.fire.after.seconds}" if:set="@{slot}.fire.after.seconds"/>
                <tstamp><format property="@{slot}.fire.time" pattern="yyyy-MM-dd HH:mm:ss.SSS"/></tstamp>
                <echo message="[LIVE] ${@{slot}.version} first token at ${@{slot}.fire.time}"/>
            </sequential>
            <sleep seconds="${@{slot}.fire.after.seconds}" if:set="@{slot}.fire.after.seconds" unless:set="@{slot}.publish.at.seconds"/>
            <fire-generator slot="@{slot}"/>
        </sequential>
    </macrodef>

    <!-- All generators run together, so their workflows run concurrently. -->
    <target name="fire-tokens">
        <parallel>
            <run-generator slot="eg1"/><run-generator slot="eg2"/><run-generator slot="eg3"/>
        </parallel>
    </target>

    <target name="run-complete-workflow" depends="prepare-runtime,resolve-deployment-modes,clean-output,rebuild-service-ruleml"
            description="Initialise, run the process and collect its records (default)">
        <echo message="================================================================"/>
        <echo message="  ${process.title}"/>
        <echo message="  Versions ${query.version}: ${token.count} tokens from each event generator"/>
        <echo message="================================================================"/>
        <parallel>
            <start-host node="p1" label="P1"/><start-host node="p2" label="P2"/><start-host node="p3" label="P3"/>
            <start-host node="p4" label="P4"/><start-host node="p5" label="P5"/><start-host node="p6" label="P6"/>
            <echo message="  [monitor] Skipping - running on remote host" unless:set="monitor.is.local"/>
            <java failonerror="true" classname="${service.loader.class}" if:set="monitor.is.local"
                  fork="true" timeout="600000" dir="${monitor.project.dir}" output="${monitor.output.file}">
                <classpath refid="monitor.classpath"/>
                <!-- Monitor runs from its own project; it reads this run's generated master ruleset, as the hosts do. -->
                <jvmarg value="-Dbtsn.common.dir=${common.project.dir}"/>
                <arg value="${monitor.project.dir}"/>
                <arg value="-version"/><arg value="${rule.version}"/>
            </java>
            <sequential>
                <!-- Hosts on other machines must run packages built from this same master ruleset (see their README). -->
                <java classname="org.btsn.deployment.HostPackage" fork="true" failonerror="true" classpathref="generator.classpath" if:set="remote.hosts.present">
                    <arg value="digest"/><arg file="${common.project.dir}"/>
                </java>
                <echo message="Waiting ${service.startup.seconds}s for services to start..."/>
                <sleep seconds="${service.startup.seconds}"/>

                <echo message="=== PHASE 1: DATABASE INITIALIZATION ==="/>
                <initialise-host node="p1" service="P1_InitializationService" sequence="999000000"/>
                <initialise-host node="p2" service="P2_InitializationService" sequence="999100000"/>
                <initialise-host node="p3" service="P3_InitializationService" sequence="999200000"/>
                <initialise-host node="p4" service="P4_InitializationService" sequence="999300000"/>
                <initialise-host node="p5" service="P5_InitializationService" sequence="999400000"/>
                <initialise-host node="p6" service="P6_InitializationService" sequence="999500000"/>
                <java classname="${init.event.generator.class}" fork="true" dir="${generator.project.dir}" failonerror="true">
                    <classpath refid="generator.classpath"/>
                    <arg value="-service"/><arg value="Monitor_InitializationService"/>
                    <arg value="-operation"/><arg value="${db.init.operation}"/>
                    <arg value="-version"/><arg value="${init.version}"/>
                    <arg value="-process"/><arg value="${init.process.name}"/>
                    <arg value="-sequenceId"/><arg value="999600000"/>
                    <arg value="-tokens"/><arg value="1"/>
                    <arg value="-skipDeploy"/>
                </java>
                <sleep seconds="${init.delay.seconds}"/>
                <echo message="=== Phase 1 Complete ==="/>
                <sleep seconds="${phase.delay.seconds}"/>

                <echo message="=== PHASE 2: WORKFLOW EXECUTION ==="/>
                <antcall target="deploy-workflow"/>
                <antcall target="fire-tokens"/>
                <echo message="Waiting ${workflow.completion.seconds}s for the last workflows to finish..."/>
                <sleep seconds="${workflow.completion.seconds}"/>
                <echo message="=== Phase 2 Complete ==="/>

                <echo message="=== PHASE 3: DATA COLLECTION ==="/>
                <collect-host node="p1" service="P1_CollectorService" sequence="999010000"/>
                <collect-host node="p2" service="P2_CollectorService" sequence="999020000"/>
                <collect-host node="p3" service="P3_CollectorService" sequence="999030000"/>
                <collect-host node="p4" service="P4_CollectorService" sequence="999040000"/>
                <collect-host node="p5" service="P5_CollectorService" sequence="999050000"/>
                <collect-host node="p6" service="P6_CollectorService" sequence="999060000"/>
                <echo message="=== Phase 3 Complete ==="/>
                <echo message="${process.title} COMPLETED SUCCESSFULLY"/>
                <echo message="Analyse with: ant -f ${ant.file} analyse"/>
                <echo message="Services are still running. Press Ctrl+C to stop."/>
            </sequential>
        </parallel>
    </target>

    <!-- One self-contained package per machine for the hosts that run on other machines: <launcher>_<nodes>, for example
         P1_P2_P3_P4_ForkRebalance_Workflow_LiveChange_P3P6 for P3 and P6 on 192.168.1.90. -->
    <property name="host.packages" value="remote"/>
    <property name="host.packages.dir" location="${services.project.dir}/target/host-packages/${ant.project.name}"/>
    <macrodef name="choose-package-node">
        <attribute name="node"/><attribute name="label"/>
        <sequential>
            <condition property="@{node}.package"><and>
                <isset property="run.@{node}"/>
                <or><not><isset property="@{node}.is.local"/></not><equals arg1="${host.packages}" arg2="all"/></or>
            </and></condition>
            <condition property="@{node}.package.label" value="@{label}," else=""><isset property="@{node}.package"/></condition>
        </sequential>
    </macrodef>

    <target name="host-packages" depends="prepare-runtime,resolve-deployment-modes,generate-workflow-bindings"
            description="Package the hosts that run on other machines, one package per machine (-Dhost.packages=all packages every host)">
        <echo message="Packaging hosts for ${process.title} on ${infrastructure.definition.name}, rules ${rule.version}..."/>
        <choose-package-node node="p1" label="P1"/><choose-package-node node="p2" label="P2"/><choose-package-node node="p3" label="P3"/>
        <choose-package-node node="p4" label="P4"/><choose-package-node node="p5" label="P5"/><choose-package-node node="p6" label="P6"/>
        <java classname="org.btsn.deployment.HostPackage" fork="true" failonerror="true" classpathref="generator.classpath">
            <arg value="nodes=${p1.package.label}${p2.package.label}${p3.package.label}${p4.package.label}${p5.package.label}${p6.package.label}"/>
            <arg value="version=${rule.version}"/><arg value="launcher=${ant.project.name}"/>
            <arg value="runtime=${launcher.runtime.dir}"/><arg value="source=${source.root}"/><arg value="bundle=${service.bundle.dir}"/>
            <arg value="infrastructureJar=${infrastructure.jar}"/><arg value="libs=${lib.dir}"/>
            <arg value="libExcludes=${services.project.dir}/target/runtime-library-excludes.txt"/><arg value="out=${host.packages.dir}"/>
        </java>
        <condition property="host.packages.none"><not><or>
            <isset property="p1.package"/><isset property="p2.package"/><isset property="p3.package"/>
            <isset property="p4.package"/><isset property="p5.package"/><isset property="p6.package"/>
        </or></not></condition>
        <echo message="Start each machine's package (launch.bat starts all its hosts), then run this launcher here (the ip0 machine, ${ip0.address}) with the same settings." unless:set="host.packages.none"/>
    </target>

    <target name="help" description="Usage">
        <echo message="ant                      initialise, run ${workflow.process.name} and collect (default)"/>
        <echo message="ant analyse              analyse the Monitor database after a run"/>
        <echo message="-Dtoken.count=N          tokens to fire (default ${token.count})"/>
        <echo message="-Dhost.address=127.0.0.1 run every host on this machine"/>
        <echo message="-Dp1.mode=local|remote   start or skip a host (default auto)"/>
        <echo message="-Dinfrastructure=MultiHost  use InfrastructureDefinitionFolder/MultiHost.json"/>
        <echo message="ant host-packages        package the hosts on other machines, one package per machine"/>
    </target>
</project>
