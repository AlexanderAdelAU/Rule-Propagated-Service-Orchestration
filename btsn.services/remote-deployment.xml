<?xml version="1.0" encoding="UTF-8"?>
<project name="remote-service-deployment" basedir=".">
    <target name="deployment-host" depends="inventory" description="Build independent receiver; does not start it">
        <jar destfile="${target.dir}/btsn-deployment-host.jar" basedir="${target.dir}/tools" includes="org/btsn/deployment/**">
            <manifest><attribute name="Main-Class" value="org.btsn.deployment.DeploymentHost"/></manifest>
        </jar>
    </target>
    <target name="remote-bundle" depends="build-workflow-runtime,deployment-host" description="Package everything required at a destination without repository access">
        <delete dir="${target.dir}/remote-bundle"/>
        <mkdir dir="${target.dir}/remote-bundle"/>
        <copy todir="${target.dir}/remote-bundle/btsn.common">
            <fileset dir="${common.dir}" includes="RuleBase/**,ServiceAttributeBindings/**,BusinessServiceDefinitions/**,ProcessDefinitionFolder/**,PayLoad/**,target/host-runtime/*.jar"/>
        </copy>
        <copy todir="${target.dir}/remote-bundle/btsn.common/lib">
            <fileset dir="${common.dir}/lib" includes="*.jar" excludesfile="${target.dir}/runtime-library-excludes.txt"/>
        </copy>
        <copy todir="${target.dir}/remote-bundle/btsn.services/target/deployment"><fileset dir="${target.dir}/deployment" includes="services/*.jar,lib/*.jar,deployment-index.json"/></copy>
        <macrodef name="copy-runtime-component">
            <attribute name="directory"/>
            <sequential>
                <copy todir="${target.dir}/remote-bundle/@{directory}">
                    <fileset dir="../@{directory}" includes="target/*.jar,target/jar-runtime/*.jar,ServiceLoaderQueries/**,RuleFolder.*/**,resources/**,PayLoad/**" excludes="**/*.log,**/*.class"/>
                </copy>
            </sequential>
        </macrodef>
        <copy-runtime-component directory="btsn.petrinet.places.p1"/>
        <copy-runtime-component directory="btsn.petrinet.places.p2"/>
        <copy-runtime-component directory="btsn.petrinet.places.p3"/>
        <copy-runtime-component directory="btsn.petrinet.places.p4"/>
        <copy-runtime-component directory="btsn.petrinet.places.p5"/>
        <copy-runtime-component directory="btsn.petrinet.places.p6"/>
        <copy-runtime-component directory="btsn.common.Monitor"/>
        <delete file="${target.dir}/remote-service-deployment.zip"/>
        <zip destfile="${target.dir}/remote-service-deployment.zip" basedir="${target.dir}/remote-bundle" modificationtime="315532800000"/>
    </target>
    <target name="check-remote" depends="check-hosts,remote-bundle" description="Exercise upload and actual service startup on an independent receiver JVM">
        <mkdir dir="${target.dir}/remote-check"/>
        <javac srcdir="tests" destdir="${target.dir}/remote-check" includes="DeploymentIntegrationCheck.java" release="${java.release}" includeantruntime="false">
            <classpath><pathelement location="${target.dir}/btsn-deployment-host.jar"/></classpath>
        </javac>
        <java classname="org.btsn.deployment.DeploymentIntegrationCheck" fork="true" failonerror="true">
            <classpath><pathelement location="${target.dir}/remote-check"/><pathelement location="${target.dir}/btsn-deployment-host.jar"/></classpath>
            <arg file="${target.dir}/remote-service-deployment.zip"/><arg file="${target.dir}/btsn-deployment-host.jar"/><arg file="${target.dir}/host-check/classes"/>
        </java>
    </target>
    <target name="deploy-start" depends="remote-bundle" description="Upload package and request service start on an already running host">
        <fail unless="deployment.host">Set -Ddeployment.host to the receiving host address</fail>
        <fail unless="deployment.port">Set -Ddeployment.port to the receiving host port</fail>
        <fail unless="deployment.token">Set -Ddeployment.token to the receiver token</fail>
        <fail unless="deployment.component">Set -Ddeployment.component=p1 through p6 or monitor</fail>
        <property name="deployment.version" value="v001"/>
        <java classname="org.btsn.deployment.DeploymentClient" fork="true" failonerror="true">
            <classpath><pathelement location="${target.dir}/btsn-deployment-host.jar"/></classpath>
            <arg value="${deployment.host}"/><arg value="${deployment.port}"/><arg value="${deployment.token}"/>
            <arg file="${target.dir}/remote-service-deployment.zip"/><arg value="${deployment.component}"/><arg value="${deployment.version}"/>
        </java>
    </target>
</project>
