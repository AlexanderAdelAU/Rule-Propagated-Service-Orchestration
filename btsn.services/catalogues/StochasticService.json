{
  "domain": "PetriNetModels",
  "purpose": "Reusable stochastic Boolean service, independent of process topology.",
  "services": [
    {
      "service": "StochasticService",
      "implementationClass": "org.btsn.services.StochasticService",
      "operation": "processToken",
      "inputs": [
        "data"
      ],
      "returnAttribute": "decision",
      "resultType": "boolean",
      "status": "preserved-unbound"
    },
    {
      "service": "StochasticPlaceService",
      "implementationClass": "org.btsn.services.StochasticPlaceService",
      "operation": "processToken",
      "inputs": [
        "token"
      ],
      "returnAttribute": "token",
      "status": "preserved-unbound"
    }
  ]
}
