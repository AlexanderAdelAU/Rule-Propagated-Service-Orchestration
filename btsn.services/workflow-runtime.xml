<?xml version="1.0" encoding="UTF-8"?>
<project name="workflow-infrastructure-tools" default="jar" basedir=".">
    <property name="common.dir" location="../btsn.common"/>
    <property name="java.release" value="15"/>
    <path id="runtime.classpath">
        <pathelement location="${common.dir}/target/host-runtime/btsn-infrastructure.jar"/>
        <fileset dir="target/deployment/services" includes="*.jar"/>
        <fileset dir="target/deployment/lib" includes="*.jar"/>
        <fileset dir="${common.dir}/lib" includes="*.jar" excludesfile="target/runtime-library-excludes.txt"/>
    </path>
    <macrodef name="build-component">
        <attribute name="directory"/><attribute name="artifact"/>
        <sequential>
            <delete dir="@{directory}/target/jar-runtime/classes"/>
            <mkdir dir="@{directory}/target/jar-runtime/classes"/>
            <mkdir dir="@{directory}/target/jar-runtime/empty-sourcepath"/>
            <javac srcdir="@{directory}/src" destdir="@{directory}/target/jar-runtime/classes"
                   sourcepath="@{directory}/target/jar-runtime/empty-sourcepath"
                   release="${java.release}" includeantruntime="false" encoding="UTF-8">
                <classpath refid="runtime.classpath"/>
            </javac>
            <copy todir="@{directory}/target/jar-runtime/classes"><fileset dir="@{directory}/src" excludes="**/*.java,**/*.class"/></copy>
            <jar destfile="@{directory}/target/jar-runtime/@{artifact}.jar"
                 basedir="@{directory}/target/jar-runtime/classes" modificationtime="315532800000"/>
        </sequential>
    </macrodef>
    <target name="jar">
        <build-component directory="../btsn.common.Monitor" artifact="btsn-monitor"/>
        <build-component directory="../btsn.common.eventgenerators" artifact="btsn-eventgenerators"/>
    </target>
    <target name="check-analysis" depends="jar" description="Check recorded-event reconstruction of single and double joins">
        <delete dir="target/analysis-check"/>
        <mkdir dir="target/analysis-check/classes"/>
        <mkdir dir="target/analysis-check/runtime"/>
        <path id="analysis.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/analysis-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/analysis-check/classes"
               includes="DoubleJoinAnalysisCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="analysis.check.classpath"/>
        </javac>
        <java classname="DoubleJoinAnalysisCheck" fork="true" failonerror="true" dir="target/analysis-check/runtime" maxmemory="128m">
            <classpath refid="analysis.check.classpath"/>
        </java>
    </target>
    <target name="check-service-names" depends="jar" description="Check business labels without changing physical identities or measurements">
        <delete dir="target/service-names-check"/>
        <mkdir dir="target/service-names-check/classes"/>
        <mkdir dir="target/service-names-check/runtime"/>
        <path id="service.names.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/service-names-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/service-names-check/classes"
               includes="ServiceNamingAnalysisCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="service.names.check.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.ServiceNamingAnalysisCheck" fork="true" failonerror="true"
              dir="target/service-names-check/runtime" maxmemory="128m">
            <classpath refid="service.names.check.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <arg file="${common.dir}"/>
        </java>
    </target>
    <target name="check-measured-timeline" depends="jar" description="Check absolute workflow timing with serial, fork/join and incomplete observation fixtures">
        <delete dir="target/measured-timeline-check"/>
        <mkdir dir="target/measured-timeline-check/classes"/>
        <mkdir dir="target/measured-timeline-check/runtime"/>
        <path id="measured.timeline.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/measured-timeline-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/measured-timeline-check/classes"
               includes="MeasuredWorkflowTimelineCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="measured.timeline.check.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.MeasuredWorkflowTimelineCheck" fork="true" failonerror="true"
              dir="target/measured-timeline-check/runtime" maxmemory="128m">
            <classpath refid="measured.timeline.check.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
    </target>
    <target name="check-combined-workflow" depends="jar" description="Check measured workflow bars and independent fork-family queue markers">
        <delete dir="target/combined-workflow-check"/>
        <mkdir dir="target/combined-workflow-check/classes"/>
        <mkdir dir="target/combined-workflow-check/runtime"/>
        <path id="combined.workflow.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/combined-workflow-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/combined-workflow-check/classes"
               includes="CombinedWorkflowMetricsCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="combined.workflow.check.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.CombinedWorkflowMetricsCheck" fork="true" failonerror="true"
              dir="target/combined-workflow-check/runtime" maxmemory="128m">
            <classpath refid="combined.workflow.check.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
    </target>
    <target name="check-queue-view" depends="jar" description="Check measured per-operation waits and legacy queue markers without invented duration bars">
        <delete dir="target/queue-view-check"/>
        <mkdir dir="target/queue-view-check/classes"/>
        <mkdir dir="target/queue-view-check/runtime"/>
        <path id="queue.view.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/queue-view-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/queue-view-check/classes"
               includes="ServiceQueueTimingCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="queue.view.check.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.ServiceQueueTimingCheck" fork="true" failonerror="true"
              dir="target/queue-view-check/runtime" maxmemory="128m">
            <classpath refid="queue.view.check.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
    </target>
    <target name="check-healthcare-names" depends="jar" description="Read-only naming check after the default ten-patient healthcare run">
        <mkdir dir="target/healthcare-names-check/classes"/>
        <path id="healthcare.names.check.classpath">
            <path refid="runtime.classpath"/>
            <pathelement location="../btsn.common.Monitor/target/jar-runtime/btsn-monitor.jar"/>
            <pathelement location="target/healthcare-names-check/classes"/>
        </path>
        <javac srcdir="../btsn.common.Monitor/tests" destdir="target/healthcare-names-check/classes"
               includes="ServiceNamingRuntimeCheck.java" release="${java.release}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="healthcare.names.check.classpath"/>
        </javac>
        <java classname="org.btsn.derby.Analysis.ServiceNamingRuntimeCheck" fork="true" failonerror="true"
              dir="../btsn.common.Monitor" maxmemory="128m">
            <classpath refid="healthcare.names.check.classpath"/>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
    </target>
</project>
