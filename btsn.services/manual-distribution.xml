<?xml version="1.0" encoding="UTF-8"?>
<project name="manual-service-distribution" basedir=".">
    <target name="distribution" depends="build-workflow-runtime" description="Build two executable JARs and manual startup ZIP">
        <delete file="${target.dir}/btsn-deployment-host.jar"/>
        <delete file="${target.dir}/remote-service-deployment.zip"/>
        <delete dir="${target.dir}/remote-bundle"/>
        <delete dir="${target.dir}/remote-check"/>
        <property name="distribution.dir" location="${target.dir}/manual-distribution"/>
        <delete dir="${distribution.dir}"/>
        <mkdir dir="${distribution.dir}"/>
        <jar destfile="${distribution.dir}/btsn-business-services.jar" modificationtime="315532800000">
            <fileset dir="${target.dir}/tools" includes="org/btsn/launch/BusinessServicesMain.class"/>
            <zipgroupfileset dir="${target.dir}/deployment/services" includes="*.jar"/>
            <zipfileset src="${target.dir}/deployment/lib/service-support.jar" excludes="META-INF/**"/>
            <manifest>
                <attribute name="Main-Class" value="org.btsn.launch.BusinessServicesMain"/>
                <attribute name="Class-Path" value="btsn-infrastructure.jar"/>
            </manifest>
        </jar>
        <jar destfile="${distribution.dir}/btsn-infrastructure.jar" modificationtime="315532800000">
            <fileset dir="${target.dir}/tools" includes="org/btsn/launch/InfrastructureMain.class,org/btsn/launch/ManualServiceLauncher.class"/>
            <zipfileset dir="${common.dir}/target/host-runtime" includes="btsn-infrastructure.jar" fullpath="runtime/common.jar"/>
            <zipfileset dir="${common.dir}/lib" includes="*.jar" excludesfile="${target.dir}/runtime-library-excludes.txt" prefix="runtime/lib"/>
            <zipfileset dir="${target.dir}/deployment/lib" includes="*.jar" excludes="service-support.jar" prefix="runtime/lib"/>
            <zipfileset dir="../btsn.petrinet.places.p1/target" includes="btsn.petrinet.places.p1.jar" fullpath="runtime/components/p1.jar"/>
            <zipfileset dir="../btsn.petrinet.places.p2/target" includes="btsn.petrinet.places.p2.jar" fullpath="runtime/components/p2.jar"/>
            <zipfileset dir="../btsn.petrinet.places.p3/target" includes="btsn.petrinet.places.p3.jar" fullpath="runtime/components/p3.jar"/>
            <zipfileset dir="../btsn.petrinet.places.p4/target" includes="btsn.petrinet.places.p4.jar" fullpath="runtime/components/p4.jar"/>
            <zipfileset dir="../btsn.petrinet.places.p5/target" includes="btsn.petrinet.places.p5.jar" fullpath="runtime/components/p5.jar"/>
            <zipfileset dir="../btsn.petrinet.places.p6/target" includes="btsn.petrinet.places.p6.jar" fullpath="runtime/components/p6.jar"/>
            <zipfileset dir="../btsn.common.Monitor/target/jar-runtime" includes="btsn-monitor.jar" fullpath="runtime/components/monitor.jar"/>
            <manifest><attribute name="Main-Class" value="org.btsn.launch.InfrastructureMain"/></manifest>
        </jar>
        <copy todir="${distribution.dir}/config/btsn.common">
            <fileset dir="${common.dir}" includes="RuleBase/**,ServiceAttributeBindings/**,BusinessServiceDefinitions/**,ProcessDefinitionFolder/**,PayLoad/**"/>
        </copy>
        <macrodef name="copy-service-configuration">
            <attribute name="directory"/>
            <sequential>
                <copy todir="${distribution.dir}/config/@{directory}">
                    <fileset dir="../@{directory}" includes="ServiceLoaderQueries/**,RuleFolder.*/**,resources/**,PayLoad/**" excludes="**/*.log,**/*.class"/>
                </copy>
            </sequential>
        </macrodef>
        <copy-service-configuration directory="btsn.petrinet.places.p1"/>
        <copy-service-configuration directory="btsn.petrinet.places.p2"/>
        <copy-service-configuration directory="btsn.petrinet.places.p3"/>
        <copy-service-configuration directory="btsn.petrinet.places.p4"/>
        <copy-service-configuration directory="btsn.petrinet.places.p5"/>
        <copy-service-configuration directory="btsn.petrinet.places.p6"/>
        <copy-service-configuration directory="btsn.common.Monitor"/>
        <copy todir="${distribution.dir}"><fileset dir="distribution"/></copy>
        <fixcrlf srcdir="${distribution.dir}" includes="*.bat" eol="crlf"/>
        <fixcrlf srcdir="${distribution.dir}" includes="*.sh" eol="lf"/>
        <delete file="${target.dir}/btsn-services.zip"/>
        <zip destfile="${target.dir}/btsn-services.zip" modificationtime="315532800000">
            <zipfileset dir="${distribution.dir}" excludes="*.sh"/>
            <zipfileset dir="${distribution.dir}" includes="*.sh" filemode="755"/>
        </zip>
        <echo>Manual deployment ZIP: ${target.dir}/btsn-services.zip</echo>
    </target>
    <target name="check-distribution" depends="check-hosts,distribution" description="Test executable two-JAR startup from an isolated copied ZIP">
        <mkdir dir="${target.dir}/manual-check"/>
        <javac srcdir="tests" destdir="${target.dir}/manual-check" includes="ManualDistributionCheck.java" release="${java.release}" includeantruntime="false"/>
        <java classname="ManualDistributionCheck" fork="true" failonerror="true">
            <classpath><pathelement location="${target.dir}/manual-check"/></classpath>
            <arg file="${target.dir}/btsn-services.zip"/><arg file="${target.dir}/host-check/classes"/>
        </java>
    </target>
</project>
