<?xml version="1.0" encoding="UTF-8"?>
<project name="btsn.common.Monitor" default="jar" basedir=".">
    <description>Build the current Monitor against independently packaged runtime dependencies.</description>
    <property name="services.project.dir" location="../btsn.services"/>
    <target name="clean" description="Remove generated Monitor JAR build output">
        <delete dir="target/jar-runtime"/>
    </target>
    <target name="prepare" description="Build the service bundle and shared infrastructure">
        <ant antfile="${services.project.dir}/build.xml" target="runtime" inheritall="false"/>
    </target>
    <target name="jar" depends="prepare" description="Build target/jar-runtime/btsn-monitor.jar">
        <ant antfile="${services.project.dir}/workflow-runtime.xml" target="jar-monitor" inheritall="false"/>
    </target>
    <target name="compile" depends="jar" description="Compile and package the Monitor"/>
    <target name="release" depends="jar" description="Build the Monitor runtime JAR"/>
</project>
